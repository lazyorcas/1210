<%= link_to @path, class: class_names("flex-1 flex justify-center h-fit", { "text-neutral-400": !current_page?(@path) }) do %>
  <div class="relative">
    <%= heroicon @icon_name, variant: current_page?(@path) ? "solid" : "outline", options: { class: "h-6 w-6" } %>
    <% if @indicator_count && @indicator_count > 0 %>
      <div class="status status--textful absolute top-0 right-0 -mt-3 -mr-3">
        <%= @indicator_count %>
      </div>
    <% elsif @show_indicator %>
      <div class="status status--empty absolute top-0 right-0 -mt-2 -mr-2"></div>
    <% end %>
  </div>
<% end %>
