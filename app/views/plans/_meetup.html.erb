<article class="card flex gap-x-4" id="<%= dom_id meetup %>">
  <div class="grow flex flex-col gap-y-2">
    <div>
      <p class="text-sm"><%= [meetup.organizer.name, meetup.attendees.map(&:name)].flatten.join(', ') %></p>
      <p class="text-sm"><%= meetup.start_time  %> - <%= meetup.end_time  %></p>
    </div>
    <h2 class="text-xl font-bold"><%= meetup.title %></h2>
    <% if meetup.description.present? %>
      <p><%= meetup.description %></p>
    <% end %>
  </div>
  <% if meetup.organizer_id != current_user.id %>
    <aside class="shrink-0 mt-auto">
      <%= render partial: "meetups/invitations/invitee_form", locals: { invitation: meetup.invitations.find_by(invitee: current_user) } %>
    </aside>
  <% end %>
</article>
