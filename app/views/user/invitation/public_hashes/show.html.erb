<main class="my-auto w-full p-4 flex flex-col gap-y-16">
  <header class="w-full flex flex-col">
    <%= link_to root_path, class: "text-xl font-black flex items-center gap-x-2" do %>
      <%= heroicon "chevron-left", options: { class: "h-4 w-4" } %>
      1210
    <% end %>
    <h1 class="text-5xl font-black">
      <%= @inviter.name %><br/> says hello.
    </h1>
  </header>
  <% if @inviter == current_user %>
    <p>Waiting for someone to accept your invitation.</p>
  <% else %>
    <%= form_with model: @user_invitation do |form| %>
      <%= form.hidden_field :is_accepted, value: true, required: true %>
      <%= form.button :submit, class: "w-full btn btn--primary btn--with-icon" do %>
        <%= heroicon "sparkles", variant: "solid" %>
        Accept
      <% end %>
    <% end %>
  <% end %>
</main>
