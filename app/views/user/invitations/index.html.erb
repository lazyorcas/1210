<header class="flex items-center gap-x-4 py-4">
  <%= link_to root_path do %>
    <%= heroicon "chevron-left", options: { class: "h-6 w-6" } %>
  <% end %>
  <h1 class="text-4xl font-black">Friends</h1>
</header>
<% if current_user.friends.present? %>
  <div class="text-neutral-500 flex items-center gap-x-2">
    <%= heroicon "information-circle", options: { class: "shrink-0 h-6 w-6" } %>
    <p class="text-sm">
      The number below each avatar indicates the last time you met up this person through here.
    </p>
  </div>
<% end %>
<main class="grow w-full flex flex-col gap-y-4 pt-4 pb-[84px] standalone:pb-[120px]">
  <% if current_user.friends.empty? %>
    <p>You have no friends on here yet.</p>
  <% else %>
    <ul class="grid grid-cols-3 sm:grid-cols-5 gap-4">
      <% current_user.friends.order(:name).each do |user| %>
        <% last_meetup_with_current_user = user.last_meetup_with(current_user) %>
        <li class="flex flex-col items-center gap-y-2 text-center">
          <div class="w-full avatar bg-neutral-900 text-white text-2xl font-bold">
            <%= user.name.first %>
          </div>
          <div class="flex flex-col items-center">
            <%= user.name %>
            <p class="text-xs text-neutral-400">
              <% if last_meetup_with_current_user.present? %>
                <%= time_ago_in_words last_meetup_with_current_user %> ago
              <% else %>
                never
              <% end %>
            </p>
          </div>
        </li>
      <% end %>
      <% current_user.received_invitations.pending.each do |invitation| %>
        <li class="flex flex-col items-center gap-y-2 text-center">
          <%= form_with model: invitation, class: "w-full" do |form| %>
            <%= form.hidden_field :is_accepted, value: true, required: true %>
            <%= form.button :submit, class: "avatar bg-neutral-200 hover:bg-neutral-900 transition-colors group" do %>
              <%= heroicon "check", options: { class: "group-hover:text-white h-8 w-8" } %>
            <% end %>
          <% end %>
          <%= invitation.inviter.name %>
        </li>
      <% end %>
    </ul>
  <% end %>
</main>
<nav class="bottom-nav gap-x-4">
  <%= link_to user_path(current_user, add_friend: true), class: "btn btn--secondary flex-1", data: { turbo_frame: "modal" } do %>
    Add friend
  <% end %>
  <%= link_to user_path(current_user), class: "btn btn--primary flex-1", data: { turbo_frame: "modal" } do %>
    Invite friends
  <% end %>
</nav>
<%= turbo_frame_tag "modal" %>
