<article id="<%= dom_id(comment) %>">
  <time class="text-sm text-neutral-400" datetime="<%= comment.created_at %>">
    <%= time_ago_in_words comment.created_at %> ago
  </time>
  <div class="flex gap-x-2">
    <p class="font-semibold"><%= comment.author.name %>:</p>
    <p class="linkable"><%= auto_link(comment.body, html: { target: '_blank' }) %></p>
  </div>
</article>
