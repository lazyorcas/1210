<%= render layout: "shared/modal", locals: { title: "What's your city?" } do %>
  <%= turbo_frame_tag "refresh", target: "_top" do %>
    <%= form_with model: current_user, url: current_user_update_path, class: "form-flow sm:w-[400px] mt-4" do |form| %>
      <div class="flex flex-col gap-y-1">
        <%= form.select :city, @city_options, { include_blank: true }, class: "w-full input select", required: true %>
        <p class="text-sm text-neutral-400">If you don't see your city, please send me an email.</p>
      </div>
      <%= form.button "Save", class: "btn btn--primary" %>
    <% end %>
  <% end %>
<% end %>
