<main class="social-network__main">
  <nav class="flex flex-wrap items-center gap-1">
    <p class="text-sm">Last met:</p>
    <%= link_to current_user_friends_path, class: class_names("chip flex items-center gap-x-1", params[:last_met].nil? ? "chip--active" : "chip--inactive") do %>
      Any
    <% end %>
    <%= link_to current_user_friends_path(last_met: "last_two_weeks"), class: class_names("chip flex items-center gap-x-1", params[:last_met] == "last_two_weeks" ? "chip--active" : "chip--inactive") do %>
      &le; 2 weeks
    <% end %>
    <%= link_to current_user_friends_path(last_met: "more_than_two_weeks_ago"), class: class_names("chip flex items-center gap-x-1", params[:last_met] == "more_than_two_weeks_ago" ? "chip--active" : "chip--inactive") do %>
      &gt; 2 weeks
    <% end %>
  </nav>
  <% if @friends.empty? %>
    <% if params[:last_met].present? %>
      <%= render partial: "shared/nothing_here" %>
    <% else %>
      <p>You have no friends on here yet.</p>
    <% end %>
  <% end %>
  <ul class="grid grid-cols-3 gap-4">
    <% @friends.each do |user| %>
      <% last_meetup = PastMeetup.between_users(current_user, user).order(date: :desc).first %>
      <li class="flex flex-col items-center gap-y-1 text-center">
        <div class="relative w-full">
          <% if user.avatar.attached? %>
            <%= image_tag photo_path(id: user.avatar.id), class: "avatar rounded-xl" %>
          <% else %>
            <div class="avatar rounded-xl bg-neutral-900 text-white text-2xl font-bold flex items-center justify-center"><%= user.name.first %></div>
          <% end %>
          <div class="absolute -right-0.5 -bottom-0.5 p-0.5 bg-white rounded-xl">
            <p class="<%= class_names("text-status", {
              "text-status--success": last_meetup && 2.weeks.ago <= last_meetup.date,
              "text-status--warning": last_meetup && last_meetup.date < 2.weeks.ago,
              "text-status--error": last_meetup.nil?,
            }) %>">
              <% if last_meetup.present? %>
                <%= time_ago_in_words(last_meetup.date, scope: 'datetime.distance_in_words.abbrv') %>
              <% else %>
                never
              <% end %>
            </p>
          </div>
        </div>
        <p class="text-sm"><%= user.name %></p>
      </li>
    <% end %>
    <% current_user.received_invitations.pending.each do |user_invitation| %>
      <li class="flex flex-col items-center gap-y-1 text-center">
        <%= form_with model: user_invitation, class: "w-full" do |form| %>
          <%= form.hidden_field :is_accepted, value: true, required: true %>
          <%= form.button :submit, class: "w-full avatar bg-neutral-200 hover:bg-neutral-900 transition-colors group" do %>
            <%= heroicon "check", options: { class: "group-hover:text-white h-8 w-8" } %>
          <% end %>
        <% end %>
        <%= user_invitation.inviter.name %>
      </li>
    <% end %>
  </ul>
</main>
