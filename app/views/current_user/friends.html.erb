<% content_for :page_title, "Friends" %>
<% content_for :back_path, current_user_path %>
<% content_for :toolbar do %>
  <%= link_to user_path(current_user), class: "icon-btn btn--primary", data: { turbo_frame: "modal" } do %>
    <%= heroicon "user-plus", variant: current_user.friends.count > 10 ? "outline" : "solid" %>
  <% end %>
<% end %>
<main class="grow w-full flex flex-col gap-y-4 p-4 standalone:pb-10">
  <nav class="flex gap-1">
    <%= link_to current_user_friends_path, class: class_names("chip flex items-center gap-x-1", params[:last_met].nil? ? "chip-tab--active" : "chip-tab--inactive") do %>
      All
    <% end %>
    <%= link_to current_user_friends_path(last_met: "last_two_weeks"), class: class_names("chip flex items-center gap-x-1", params[:last_met] == "last_two_weeks" ? "chip-tab--active" : "chip-tab--inactive") do %>
      Met recently
    <% end %>
    <%= link_to current_user_friends_path(last_met: "more_than_two_weeks_ago"), class: class_names("chip flex items-center gap-x-1", params[:last_met] == "more_than_two_weeks_ago" ? "chip-tab--active" : "chip-tab--inactive") do %>
      Been a while
    <% end %>
  </nav>
  <% if @friends.empty? %>
    <% if params[:last_met].present? %>
      <%= render partial: "shared/nothing_here" %>
    <% else %>
      <p class="card text-sm">You have no friends on here yet.</p>
    <% end %>
  <% else %>
    <ul class="card grid grid-cols-3 gap-4">
      <% @friends.each do |user| %>
        <% last_meetup = PastMeetup.between_users(current_user, user).order(date: :desc).first %>
        <li class="flex flex-col items-center gap-y-1 text-center">
          <div class="relative w-full">
            <% if user.avatar.attached? %>
              <%= image_tag photo_path(id: user.avatar.id), class: "avatar rounded-xl" %>
            <% else %>
              <div class="avatar rounded-xl bg-neutral-900 text-white text-2xl font-bold flex items-center justify-center"><%= user.name.first %></div>
            <% end %>
            <div class="absolute -right-0.5 -bottom-0.5 p-0.5 bg-white rounded-xl">
              <p class="<%= class_names("text-status", {
              "text-status--success": last_meetup && 2.weeks.ago <= last_meetup.date,
              "text-status--warning": last_meetup && last_meetup.date < 2.weeks.ago,
              "text-status--error": last_meetup.nil?,
            }) %>">
                <% if last_meetup.present? %>
                  <%= time_ago_in_words(last_meetup.date, scope: 'datetime.distance_in_words.abbrv') %>
                <% else %>
                  never
                <% end %>
              </p>
            </div>
          </div>
          <p class="text-sm"><%= user.name %></p>
        </li>
      <% end %>
    </ul>
  <% end %>
</main>
