<%= render ModalComponent.new(title: "When might you be free?") do |component| %>
  <% component.with_body do %>
    <div class="px-4 modal-pb">
      <p class="mb-4 text-sm text-neutral-500">For the next 7 days. Visible to all friends.</p>
      <div class="flex flex-col gap-y-8">
        <% @date_availabilities_pairs.each do |date, time_of_day_availabilities_pairs| %>
          <section class="flex flex-col gap-y-2">
            <h2 class="font-semibold"><%= relative_to_today(date) %></h2>
            <ul class="grid grid-cols-2 gap-2">
              <% time_of_day_availabilities_pairs.each do |time_of_day, availability| %>
                <%= render availability %>
              <% end %>
            </ul>
          </section>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
