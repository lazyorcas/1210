<li id="<%= availability_dom_id(availability) %>">
  <% if availability.persisted? %>
    <%= form_with model: availability, url: current_user_availability_path(availability), method: :delete do |form| %>
      <%= form.button class: "w-full tag tag--success text-left" do %>
        <%= availability.time_of_day.capitalize %>
      <% end %>
    <% end %>
  <% else %>
    <%= form_with model: availability, url: current_user_availabilities_path do |form| %>
      <%= form.hidden_field :date, required: true %>
      <%= form.hidden_field :time_of_day, required: true %>
      <%= form.button class: "w-full tag tag--inactive flex items-center justify-between gap-x-1" do %>
        <div><%= availability.time_of_day.capitalize %></div>
        <% if availability.user_friends_in_availbility_group.count > 0 %>
          <div class="text-xs bg-neutral-300 text-neutral-600 rounded-full min-w-[16px] px-1">
            <%= availability.user_friends_in_availbility_group.count %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</li>
