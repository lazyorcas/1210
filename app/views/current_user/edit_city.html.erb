<%= render ModalComponent.new(title: "What's your city?", close_disabled: true) do |component| %>
  <% component.with_body do %>
    <%= form_with model: current_user, url: current_user_update_path, class: "px-4 modal-pb form-flow" do |form| %>
      <%= form.text_field :city, list: "cities", class: "line-input text-xl", required: true, placeholder: "e.g. Munich", autocomplete: "off", maxlength: 30 %>
      <datalist id="cities">
        <% City.all.each do |city| %>
          <option value="<%= city %>"></option>
        <% end %>
      </datalist>
      <%= form.button "Save", class: "btn btn--primary" %>
    <% end %>
  <% end %>
<% end %>
