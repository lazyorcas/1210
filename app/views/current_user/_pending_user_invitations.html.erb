<section class="relative card flex flex-col gap-y-4">
  <h2 class="font-semibold">Friend Requests</h2>
  <% if @pending_user_invitations.present? %>
    <span class="absolute top-0 right-0 -mt-1 -mr-1 status status--empty"></span>
    <ul class="flex flex-col gap-y-4">
      <% @pending_user_invitations.each do |user_invitation| %>
        <li class="flex items-center justify-between" id="<%= dom_id(user_invitation) %>">
          <p class="text-sm"><%= user_invitation.inviter.name %></p>
          <div class="flex gap-x-2">
            <%= form_with model: user_invitation do |form| %>
              <%= form.hidden_field :is_accepted, value: true, required: true %>
              <%= form.button :submit, class: "icon-btn bg-green-500 text-white" do %>
                <%= heroicon "check" %>
              <% end %>
            <% end %>
            <%= form_with model: user_invitation do |form| %>
              <%= form.hidden_field :is_accepted, value: false, required: true %>
              <%= form.button :submit, class: "icon-btn bg-red-500 text-white" do %>
                <%= heroicon "x-mark" %>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm">Nothing new</p>
  <% end %>
</section>
