<% content_for :page_title, "You" %>
<main class="social-network__main">
  <% content_for :toolbar do %>
    <%= link_to current_user_friends_path, class: "icon-btn icon-btn--small" do %>
      <%= heroicon "user-group" %>
    <% end %>
    <%= link_to current_user_edit_avatar_path, data: { turbo_frame: "modal" } do %>
      <% if current_user.avatar.attached? %>
        <%= render partial: "users/avatar", locals: { user: current_user, size: "medium" } %>
      <% else %>
        <div class="icon-btn btn--primary">
          <%= heroicon "camera", variant: "solid" %>
        </div>
      <% end %>
    <% end %>
  <% end %>
  <%= render partial: "push_notification" %>
  <%= render partial: "pending_user_invitations" %>
</main>
