<% thing = thing.becomes(Thing) %>
<article class="snap-always snap-center min-w-full flex flex-col gap-y-4" id="<%= dom_id(thing) %>">
  <%= link_to edit_current_user_thing_path(thing), class: "polaroid polaroid--clickable overflow-y-scroll grow", data: { turbo_frame: "modal" } do %>
    <%= image_tag photo_path(id: thing.image.id), class: "thumbnail rounded-t-xl w-full" %>
    <div class="polaroid__content flex flex-col gap-y-4">
      <header>
        <h2 class="text-xl font-bold"><%= thing.title %></h2>
        <% if thing.description.present? %>
          <p class="text-sm"><%= thing.description %></p>
        <% end %>
      </header>
      <aside class="flex gap-1 flex-wrap">
        <% ([thing.type] + thing.tags.split('|')).each do |tag| %>
          <span class="chip chip--default">
            <%= tag %>
          </span>
        <% end %>
      </aside>
      <hr />
      <section class="flex flex-col gap-y-1">
        <div class="flex gap-x-2 items-center text-neutral-500">
          <%= heroicon "bookmark", options: { class: "h-4 w-4" } %>
          <h2 class="text-sm">Interested</h2>
        </div>
        <% if thing.interestees.length > 0 %>
          <%= render partial: "users/avatars", locals: { users: thing.interestees.sort_by(&:name), show_name: true } %>
        <% else %>
          <p class="text-sm">No one yet</p>
        <% end %>
      </section>
    </div>
  <% end %>
  <%= button_to current_user_thing_path(thing), method: :delete, class: "w-full btn btn--with-icon", data: { turbo_confirm: "Are you sure you want to delete this thing?" } do |form| %>
    <%= heroicon "trash" %>
    Delete
  <% end %>
</article>
