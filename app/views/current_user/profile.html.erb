<main class="grow w-full flex flex-col gap-y-8 pt-4 pb-[84px] standalone:pb-[120px]">
  <% content_for :toolbar do %>
    <%= link_to current_user_edit_avatar_path, class: "icon-btn btn--primary", data: { turbo_frame: "modal" } do %>
      <% if current_user.avatar.attached? %>
        <%= image_tag photo_path(id: current_user.avatar.id), class: "avatar rounded-md object-cover" %>
      <% else %>
        <%= heroicon "camera", options: { class: "h-6 w-6" } %>
      <% end %>
    <% end %>
  <% end %>
  <section class="flex flex-col gap-y-4">
    <header>
      <h2 class="text-lg font-semibold">Push Notifications</h2>
      <p class="text-sm text-neutral-500">Stay in the loop with your friends.
        Only available on mobile.</p>
    </header>
    <%= button_tag class: "btn btn--primary w-fit gap-x-2", data: { controller: "notification-permission",  action: "notification-permission#request" }, disabled: !browser.device.mobile? do %>
      <%= heroicon "bell-alert", options: { class: "h-6 w-6" } %>
      Enable push notification
    <% end %>
  </section>
</main>
