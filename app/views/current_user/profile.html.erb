<main class="grow w-full flex flex-col gap-y-8 pt-4 pb-[84px] standalone:pb-[120px]">
  <% content_for :toolbar do %>
    <%= link_to current_user_availabilities_path, class: "icon-btn icon-btn--small", data: { turbo_frame: "modal" } do %>
      <%= heroicon "calendar-days", options: { class: "h-6 w-6" } %>
      <% if current_user.availabilities.count == 0 %>
        <div class="status status--empty self-start shrink-0"></div>
      <% end %>
    <% end %>
    <%= link_to current_user_edit_avatar_path, data: { turbo_frame: "modal" } do %>
      <% if current_user.avatar.attached? %>
        <%= render partial: "users/avatar", locals: { user: current_user, size: "medium" } %>
      <% else %>
        <div class="icon-btn btn--primary">
          <%= heroicon "camera", options: { class: "h-6 w-6" } %>
        </div>
      <% end %>
    <% end %>
  <% end %>
  <section class="flex flex-col gap-y-4">
    <header>
      <h2 class="text-lg font-semibold">Push Notifications</h2>
      <p class="text-sm text-neutral-500">Stay in the loop with your friends.</p>
    </header>
    <%= button_tag class: "btn btn--primary w-fit gap-x-2", data: { controller: "notification-permission",  action: "notification-permission#request" }, disabled: !browser.device.mobile? do %>
      <%= heroicon "bell-alert", options: { class: "h-6 w-6" } %>
      Enable push notification
    <% end %>
  </section>
</main>
