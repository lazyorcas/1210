<%= render layout: "shared/modal", locals: { title: "Download mobile app" } do %>
  <div class="flex flex-col gap-y-4 sm:w-[400px]">
    <% if browser.platform.ios? && browser.safari?("< 16.4") %>
      <p>Your iOS version must be <b>at least 16.4</b>.</p>
    <% end %>
    <ol class="flex flex-col gap-y-1">
      <li class="flex items-center gap-x-1">1. Click <%= heroicon browser.platform.ios? ? "arrow-up-on-square" : "ellipsis-vertical", options: { class: "h-6 w-6" } %> on your browser toolbar.</li>
      <li>2. Click <b>"Add to Home Screen"</b>.</li>
      <li>3. A popup will appear, click <b>"Add"</b>.</li>
    </ol>
    <p>Afterwards, you will be able to receive push notifications directly on your phone.</p>
  </div>
<% end %>
