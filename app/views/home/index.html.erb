<main class="w-full max-w-[320px] m-auto flex flex-col gap-y-16">
  <header class="w-full flex flex-col">
    <h1 class="text-5xl font-black">1210</h1>
    <p class="text-3xl font-bold">
      Meet up with friends. <br/>
      Spontaneously. <br/>
      More often.
    </p>
  </header>
  <div class="flex flex-col gap-y-4">
    <%= link_to new_user_path, class: 'btn btn--primary' do %>
      Create account
    <% end %>
    <%= link_to users_sign_in_path, class: 'btn btn--secondary' do %>
      Sign in
    <% end %>
  </div>
</main>
