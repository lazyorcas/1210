<header class="p-4">
  <h1 class="text-4xl font-black">1210</h1>
  <p>&ldquo;one to ten&rdquo;</p>
</header>
<main class="my-auto px-4">
  <div class="mb-4 flex flex-col gap-y-2">
    <p class="text-5xl font-black uppercase">
      Spend <br />
      more time <br />
      with <br />
      friends.
    </p>
    <p class="font-medium text-lg">Discover common interests. Mark your free time. Plan or meet spontaneously. Create memories together. All in one.</p>
  </div>
  <div class="mb-16 flex gap-x-1">
    <span class="chip chip--default">It's free</span>
  </div>
  <div class="flex flex-col gap-y-2">
    <%= link_to new_user_path, class: "btn btn--primary" do %>
      Create account
    <% end %>
    <%= link_to users_sign_in_path, class: "btn btn--secondary" do %>
      Sign in
    <% end %>
  </div>
</main>
