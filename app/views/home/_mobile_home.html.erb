<header class="p-4 flex flex-col gap-y-4">
  <a href="https://www.producthunt.com/posts/1210-social-network-for-friends?utm_source=badge-featured&utm_medium=badge&utm_souce=badge-1210&#0045;social&#0045;network&#0045;for&#0045;friends" target="_blank"><img src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=427459&theme=light" alt="1210&#0032;&#0045;&#0032;Social&#0032;Network&#0032;for&#0032;Friends - Spend&#0032;more&#0032;time&#0032;with&#0032;friends | Product Hunt" style="width: 250px; height: 54px;" width="250" height="54" /></a>
  <h1 class="text-2xl font-black">1210</h1>
</header>
<main class="px-4">
  <div class="mb-4 flex flex-col gap-y-2">
    <p class="text-5xl font-black uppercase">
      Spend <br />
      more time <br />
      with <br />
      friends.
    </p>
    <p class="font-medium">Discover common interests. Mark your free time. Plan or meet spontaneously. Create memories together. All in one.</p>
  </div>
  <div class="gap-x-1">
    <span class="chip chip--default">It's free</span>
  </div>
  <div class="my-8 flex flex-col gap-y-2">
    <%= link_to new_user_path, class: "btn btn--primary" do %>
      Create account
    <% end %>
    <%= link_to users_sign_in_path, class: "btn btn--secondary" do %>
      Sign in
    <% end %>
  </div>
  <div class="pb-8 w-full">
    <iframe class="border rounded-xl w-full" width="560" height="316" src="https://www.youtube-nocookie.com/embed/rl9qXFo8iM8?si=LIKkH4304e0wAG9a" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" loading="lazy" allowfullscreen></iframe>
  </div>
</main>
