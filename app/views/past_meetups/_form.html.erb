<%= form_with model: past_meetup, class: "form-flow sm:w-[400px]" do |form| %>
  <div class="form-inputs-flow">
    <%= form.text_field :title, class: "line-input text-xl my-2", required: true, placeholder: "Untitled", autocomplete: "off", maxlength: 20 %>
    <div class="input-container">
      <%= form.label :date do %>
        When was it?
      <% end %>
      <%= form.date_field :date, required: true, max: Time.zone.yesterday, class: "input" %>
    </div>
    <div class="input-container">
      <div>
        <%= form.label :invitee_ids do %>
          Who were there?
        <% end %>
        <p class="text-sm text-neutral-400">They can also add and see photos.</p>
      </div>
      <%= form.collection_select :invitee_ids, past_meetup.organizer.friends.order(:name), :id, :name, {}, { required: true, multiple: true } %>
    </div>
  </div>
  <%= form.button "Create memory", class: "btn btn--primary" %>
<% end %>
