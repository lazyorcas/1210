<%= render layout: "shared/modal" do %>
  <article class="sm:w-[480px] flex flex-col gap-y-8">
    <header class="flex justify-between gap-x-4">
      <div class="flex items-center gap-x-2">
        <%= heroicon "information-circle", options: { class: "h-6 w-6" } %>
        <h1 class="text-2xl font-bold">Friends</h1>
      </div>
      <%= render partial: "shared/modal_close_button" %>
    </header>
    <section class="flex flex-col gap-y-4">
      <h2 class="text-lg font-semibold">What is the number below each avatar?</h2>
      <p>It indicates the last time you met this person through 1210.</p>
    </section>
  </article>
<% end %>
