<div class="flex flex-col items-center">
  <%= image_tag "person-looking-at-watch.svg", width: 320, height: 320 %>
  <div class="flex flex-col gap-y-2">
    <p class="text-center">
      No one's free when you're free.
    </p>
    <%= link_to current_user_profile_path, class: "btn btn--primary gap-x-2" do %>
      <%= heroicon "calendar-days", options: { class: "h-6 w-6" } %>
      Mark your free time
    <% end %>
  </div>
</div>
