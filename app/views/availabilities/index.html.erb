<% content_for :page_title, "Availability" %>
<% content_for :toolbar do %>
  <%= link_to current_user_availabilities_path, class: "icon-btn btn--primary", data: { turbo_frame: "modal" } do %>
    <%= heroicon "pencil-square", variant: "solid" %>
  <% end %>
<% end %>
<% if @availability_group_users_pairs.empty? %>
  <%= render partial: "no_availabilities" %>
<% else %>
  <main class="w-full grow flex snap-mandatory snap-x overflow-x-scroll gap-x-2 px-4 pt-4 pb-[76px] standalone:pb-[100px]">
    <% @availability_group_users_pairs.each do |availability_group, users| %>
      <section class="snap-always snap-center min-w-full flex flex-col gap-y-4">
        <header class="card shrink-0 flex flex-col gap-y-2">
          <h2 class="font-semibold">
            <%= availability_group.time_of_day_emoji %> <%= relative_to_today(availability_group.date) %> <%= availability_group.time_of_day %>
          </h2>
          <%= render partial: "users/avatars", locals: { users: users.sort_by(&:name), show_name: true } %>
        </header>
        <div class="relative card card--clickable overflow-y-scroll flex flex-col">
          <h3 class="font-semibold">Common Interests</h3>
          <p class="text-sm text-neutral-500">You can pick multiple preferences.</p>
          <%= turbo_frame_tag "availability_group_#{availability_group.date}_#{availability_group.time_of_day}_things", src: availability_group_things_path(date: availability_group.date, time_of_day: availability_group.time_of_day), class: "flex flex-col divide-y", target: "_top" do %>
            <% 3.times do %>
              <%= render partial: "availability_group/things/thing_skeleton" %>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  </main>
<% end %>
