<%= turbo_frame_tag "availability_group_#{params[:date]}_#{params[:time_of_day]}_things" do %>
  <% if @thing_users_pairs.present? %>
    <div class="flex flex-col gap-y-2">
      <h3 class="font-semibold">Common Interests</h3>
      <div class="flex flex-col gap-y-4">
        <% @thing_users_pairs.each do |thing, users| %>
          <%= render partial: "thing", locals: { thing: thing, users: users } %>
        <% end %>
      </div>
    </div>
  <% elsif Thing.pending(current_user).count > 0 %>
    <%= link_to things_path, class: "shrink-0 btn btn--primary gap-x-2" do %>
      <%= heroicon "map-pin", variant: "solid", options: { class: "h-6 w-6" } %>
      Explore things to do
    <% end %>
  <% end %>
<% end %>
