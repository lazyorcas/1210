<%= turbo_frame_tag "availability_group_#{params[:date]}_#{params[:time_of_day]}_things" do %>
  <% if @thing_users_pairs.empty? %>
    <% if Thing.pending(current_user).count > 0 %>
      <%= link_to things_path, class: "btn btn--primary btn--with-icon" do %>
        <%= heroicon "map", variant: "solid" %>
        Discover
      <% end %>
    <% else %>
      <p class="text-sm">Nothing yet.</p>
    <% end %>
  <% else %>
    <% @thing_users_pairs.each do |thing, users| %>
      <%= render partial: "thing", locals: { thing: thing, users: users } %>
    <% end %>
  <% end %>
<% end %>
