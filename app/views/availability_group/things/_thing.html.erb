<% thing = thing.becomes(Thing) %>
<%= link_to availability_group_thing_path(thing, date: params[:date], time_of_day: params[:time_of_day]), class: "flex gap-x-4", data: { turbo_frame: "modal" } do %>
  <%= image_tag thing.image.attached? ? photo_path(id: thing.image.id) : thing.image_url, class: "thumbnail rounded-lg h-24 w-24" %>
  <div class="flex flex-col gap-y-2">
    <div>
      <h4 class="text-sm font-semibold"><%= thing.title %></h4>
      <% if thing.owner.present? %>
        <p class="text-xs">By <%= thing.owner.name %></p>
      <% end %>
    </div>
    <%= render partial: "users/avatars", locals: { users: users.sort_by(&:name) } %>
  </div>
<% end %>
