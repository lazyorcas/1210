<% thing = thing.becomes(Thing) %>
<article class="flex gap-x-4">
  <%= image_tag thing.image.attached? ? photo_path(id: thing.image.id) : thing.image_url, class: "shrink-0 thumbnail rounded-lg h-24 w-24" %>
  <div class="grow flex flex-col gap-y-2">
    <div>
      <%= link_to availability_group_thing_path(thing, date: params[:date], time_of_day: params[:time_of_day]), class: "text-sm font-semibold", data: { turbo_frame: "modal" } do %>
        <%= thing.title %>
      <% end %>
      <% if thing.owner.present? %>
        <p class="text-xs">By <%= thing.owner.name %></p>
      <% end %>
    </div>
    <%= render partial: "availability_group/users/avatars", locals: { users: users.sort_by(&:name), accepted_users: users.select { |user| user.available_accepted_thing_ids.include?(thing.id) } } %>
    <% if thing.owner != current_user %>
      <% availability = current_user.availabilities.find_by!(date: params[:date], time_of_day: params[:time_of_day]) %>
      <% invitation = thing.availability_invitations.find_by(invitee: availability) || Thing::Availability::Invitation.new(inviter: thing, invitee: availability) %>
      <%= render partial: "thing/availability/invitations/invitation", locals: { invitation:  invitation } %>
    <% end %>
  </div>
</article>