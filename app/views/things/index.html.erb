<% content_for :page_title, current_user.city %>
<% if current_user.friends.present? %>
  <% content_for :toolbar do %>
    <%= link_to uninteresting_things_path, class: "icon-btn icon-btn--small" do %>
      <%= heroicon "forward" %>
    <% end %>
    <%= link_to current_user_things_path, class: "icon-btn icon-btn--small" do %>
      <%= heroicon "folder" %>
    <% end %>
    <%= link_to interesting_things_path, class: "icon-btn icon-btn--small" do %>
      <%= heroicon "bookmark" %>
    <% end %>
  <% end %>
<% end %>
<% if current_user.friends.count < 2 && current_user.created_at < Time.zone.yesterday %>
  <div class="flex flex-col items-center px-4">
    <%= image_tag "person-looking-at-map.svg", width: 320, height: 320 %>
    <p class="text-center">Invite at least 2 friends to see more. It's not social until your friends join.</p>
    <%= link_to current_user_friends_path, class: "mt-2 btn btn--primary" do %>
      Invite friends
    <% end %>
  </div>
<% elsif @things.empty? %>
  <div class="flex flex-col items-center px-4">
    <%= image_tag "person-looking-at-map.svg", width: 320, height: 320 %>
    <% if current_user.friends.empty? %>
      <p class="text-center">Nothing new for this week, but invite your friends to make things happen!</p>
      <%= link_to current_user_friends_path, class: "mt-2 btn btn--primary" do %>
        Invite friends
      <% end %>
    <% else %>
      <p class="text-center">Nothing new for this week.</p>
      <%= link_to interesting_things_path, class: "mt-2 btn btn--primary" do %>
        See bookmarks
      <% end %>
    <% end %>
  </div>
<% else %>
  <main id="things" class="w-full grow flex snap-mandatory snap-x overflow-x-hidden gap-x-4 px-4 pt-4 pb-[76px] standalone:pb-[100px]">
    <%= render partial: "thing", collection: @things %>
  </main>
<% end %>
