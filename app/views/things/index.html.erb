<% if @things.empty? %>
  <%= render partial: "nothing" %>
<% else %>
  <main id="things" class="<%= class_names("mt-2 w-full grow flex snap-mandatory snap-x px-4", current_page?(interesting_things_path) ? "overflow-x-scroll gap-x-2" : "overflow-x-hidden gap-x-4") %>">
    <%= render partial: "thing", collection: @things %>
  </main>
<% end %>
