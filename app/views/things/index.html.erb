<% content_for :page_title, current_user.city %>
<% if current_user.friends.count >= 3 %>
  <% content_for :toolbar do %>
    <%= link_to interesting_things_path, class: "icon-btn icon-btn--small" do %>
      <%= heroicon "bookmark" %>
    <% end %>
  <% end %>
<% end %>
<% if current_user.friends.count < 3 %>
  <div class="flex flex-col items-center px-4">
    <%= image_tag "person-looking-at-map.svg", width: 320, height: 320 %>
    <p class="text-center">Discover things to do in the city <br />
      and your common interests.</p>
    <%= link_to new_user_invitation_path, class: "mt-2 btn btn--primary", data: { turbo_frame: "modal" } do %>
      Add 3 friends first
    <% end %>
  </div>
<% elsif @things.empty? %>
  <div class="flex flex-col items-center px-4">
    <%= image_tag "person-looking-at-map.svg", width: 320, height: 320 %>
    <p class="text-center">Nothing new. Come back in 1 week.</p>
    <%= link_to interesting_things_path, class: "mt-2 btn btn--primary" do %>
      See bookmarks
    <% end %>
  </div>
<% else %>
  <main id="things" class="w-full grow flex snap-mandatory snap-x overflow-x-hidden gap-x-4 px-4 pt-4 pb-[76px] standalone:pb-[100px]">
    <%= render partial: "thing", collection: @things %>
  </main>
<% end %>
