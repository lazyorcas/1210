<% thing = thing.becomes(Thing) %>
<article class="snap-always snap-center min-w-full flex flex-col gap-y-4" id="<%= dom_id(thing) %>">
  <div class="polaroid overflow-y-scroll grow">
    <div class="relative">
      <%= image_tag thing.image.attached? ? photo_path(id: thing.image.id) : thing.image_url, class: "thumbnail rounded-t-xl w-full" %>
      <% if thing.url.present? %>
        <%= link_to thing.url, class: "absolute right-2 top-2 icon-btn btn--secondary", target: "_blank" do %>
          <% if thing.url.include?("maps.app.goo.gl") %>
            <%= heroicon "map" %>
          <% elsif thing.url.include?("youtube") %>
            <%= heroicon "video-camera" %>
          <% else %>
            <%= heroicon "arrow-top-right-on-square" %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <div class="polaroid__content flex flex-col gap-y-4">
      <header>
        <h2 class="text-xl font-bold"><%= thing.title %></h2>
        <% if thing.description.present? %>
          <p class="text-sm"><%= thing.description %></p>
        <% end %>
      </header>
      <aside class="flex gap-1 flex-wrap">
        <% ([thing.type] + thing.tags.split('|')).each do |tag| %>
          <span class="chip chip--default">
            <%= tag %>
          </span>
        <% end %>
      </aside>
    </div>
  </div>
  <% if current_user.interests.exists?(thing.id) %>
    <%= render partial: "interesting_thing_nav", locals: { thing: thing } %>
  <% else %>
    <%= render partial: "thing_nav", locals: { thing: thing } %>
  <% end %>
</article>
