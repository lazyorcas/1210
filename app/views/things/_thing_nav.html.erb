<nav class="shrink-0 mt-auto mb-4 standalone:mb-8 flex gap-x-2 justify-center">
  <%= form_with model: thing.invitations.find_by(invitee: current_user) || Thing::Invitation.new(inviter: thing), url: thing_invitations_path(thing) do |form| %>
    <%= form.hidden_field :is_accepted, value: false, required: true %>
    <%= form.button class: "icon-btn icon-btn--big btn--primary" do %>
      <%= heroicon "x-mark", options: { class: "h-6 w-6" } %>
    <% end %>
  <% end %>
  <%= form_with model: thing.invitations.find_by(invitee: current_user) || Thing::Invitation.new(inviter: thing), url: thing_invitations_path(thing) do |form| %>
    <%= form.hidden_field :is_accepted, value: true, required: true %>
    <%= form.button class: "icon-btn icon-btn--big btn--primary" do %>
      <%= heroicon "check", options: { class: "h-6 w-6" } %>
    <% end %>
  <% end %>
</nav>
