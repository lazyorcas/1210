<nav class="shrink-0 mt-auto mb-4 standalone:mb-8 bg-neutral-100 rounded-full py-2 px-3 border flex justify-between">
  <%= link_to thing.url, class: "icon-btn icon-btn--small", target: "_blank" do %>
    <%= heroicon "arrow-top-right-on-square", options: { class: "h-6 w-6" } %>
  <% end %>
  <div class="flex gap-x-2 divide-x">
    <div class="flex gap-x-2">
      <%= link_to new_idea_path(thing_id: thing.id), class: "icon-btn icon-btn--small", data: { turbo_frame: "modal" } do %>
        <%= heroicon "heart", options: { class: "h-6 w-6" } %>
      <% end %>
      <%= link_to new_meetup_path(thing_id: thing.id), class: "icon-btn icon-btn--small", data: { turbo_frame: "modal" } do %>
        <%= heroicon "bolt", options: { class: "h-6 w-6" } %>
      <% end %>
      <%= render partial: "thing/invitations/button", locals: { thing: thing } %>
    </div>
  </div>
</nav>
