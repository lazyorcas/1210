<nav class="shrink-0 mt-auto flex gap-x-2">
  <%= form_with model: thing.invitations.find_by(invitee: current_user) || Thing::Invitation.new(inviter: thing), url: thing_invitations_path(thing), class: "flex-1" do |form| %>
    <%= form.hidden_field :is_accepted, value: false, required: true %>
    <%= form.button class: "w-full btn btn--with-icon bg-red-500 text-white" do %>
      <%= heroicon "x-mark", variant: "solid", options: { class: "h-8 w-8" } %>
      Skip for now
    <% end %>
  <% end %>
  <%= form_with model: thing.invitations.find_by(invitee: current_user) || Thing::Invitation.new(inviter: thing), url: thing_invitations_path(thing), class: "flex-1" do |form| %>
    <%= form.hidden_field :is_accepted, value: true, required: true %>
    <%= form.button class: "w-full btn btn--with-icon bg-green-500 text-white" do %>
      <%= heroicon "check", variant: "solid", options: { class: "h-8 w-8" } %>
      Bookmark
    <% end %>
  <% end %>
</nav>
