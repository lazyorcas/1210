<% thing_invitation = thing.invitations.find_by(invitee: current_user) || Thing::Invitation.new(inviter: thing) %>
<nav class="shrink-0 mt-auto flex justify-center gap-x-2">
  <% if thing_invitation.is_accepted.nil? %>
    <%= form_with model: thing_invitation, url: thing_invitation.persisted? ? thing_invitation_path(thing_id: thing.id, id: thing_invitation.id) : thing_invitations_path(thing), class: "flex-1" do |form| %>
      <%= form.hidden_field :is_accepted, value: false, required: true %>
      <%= form.button class: "w-full btn btn--with-icon bg-red-400 text-red-800" do %>
        <%= heroicon "hand-thumb-down", variant: "solid", options: { class: "h-8 w-8" } %>
        Skip
      <% end %>
    <% end %>
  <% end %>
  <%= form_with model: thing_invitation, url: thing_invitation.persisted? ? thing_invitation_path(thing_id: thing.id, id: thing_invitation.id) : thing_invitations_path(thing), class: "flex-1" do |form| %>
    <%= form.hidden_field :is_accepted, value: true, required: true %>
    <%= form.button class: "w-full btn btn--with-icon bg-green-400 text-green-800" do %>
      <%= heroicon "hand-thumb-up", variant: "solid", options: { class: "h-8 w-8" } %>
      Bookmark
    <% end %>
  <% end %>
</nav>
