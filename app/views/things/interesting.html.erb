<% content_for :page_title, "Bookmarks" %>
<% if @things.empty? %>
  <div class="flex flex-col items-center px-4">
    <%= image_tag "person-looking-at-map.svg", width: 320, height: 320 %>
    <p class="text-center">
      You haven't found anything interesting yet. <br />
      Keep searching.
    </p>
  </div>
<% else %>
  <main id="things" class="pt-4 px-4 w-full grow flex snap-mandatory snap-x overflow-x-scroll gap-x-2">
    <%= render partial: "thing", collection: @things %>
  </main>
<% end %>
