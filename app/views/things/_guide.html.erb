<%= render layout: "shared/modal", locals: { title: "How to navigate" } do %>
  <div class="mt-4 flex flex-col gap-y-4">
    <div class="flex items-center gap-x-4">
      <%= heroicon "check", options: { class: "shrink-0 h-6 w-6" } %>
      <p class="text-sm">If you bookmark, your friends will also see that you have the same interest. And vice versa.</p>
    </div>
    <div class="flex items-center gap-x-4">
      <%= heroicon "x-mark", options: { class: "shrink-0 h-6 w-6" } %>
      <p class="text-sm">If you skip, you won't see it for 1 month. After that, if still relevant, it will be shown again with low priority.</p>
    </div>
  </div>
<% end %>
