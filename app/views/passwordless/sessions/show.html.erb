<main class="w-full max-w-[320px] m-auto flex flex-col gap-y-16">
  <header class="w-full flex flex-col">
    <%= link_to root_path, class: 'text-xl font-black flex items-center gap-x-2' do %>
      <%= heroicon 'chevron-left', options: { class: "h-4 w-4" } %>
      1210
    <% end %>
    <h1 class="text-5xl font-black">Verify</h1>
    <% if notice.present? %>
      <div class="py-2 px-3 bg-green-50 text-green-500 font-medium rounded-lg mt-4" id="notice"><%= notice %></div>
    <% end %>
  </header>
  <%= form_with(model: @session, url: url_for(action: 'update'), scope: 'passwordless', method: 'patch', data: { turbo: false }, class: 'w-full form-flow') do |form| %>
    <%= form.text_field :token, placeholder: 'enter your token', class: 'input' %>
    <%= form.submit "Confirm", class: 'btn btn--primary' %>
  <% end %>
</main>
