<% friends_interested = thing.interestees & current_user.friends_in_the_same_city %>
<%= link_to thing_invitations_path(thing), class: class_names("shrink-0 icon-btn relative"), id: "#{dom_id(thing)}_invitations_button", data: { turbo_frame: "modal" } do %>
  <%= heroicon "bookmark", variant: current_user.interests.exists?(thing.id) ? "solid" : "outline" %>
  <% if friends_interested.length > 0 %>
    <div class="status status--textful absolute -mr-5 -mt-5">
      <%= friends_interested.length %>
    </div>
  <% end %>
<% end %>
