<%= form_with model: @thing_invitation, url: thing_invitation_path(@thing, @thing_invitation), class: "form-flow sm:w-[400px]", data: { turbo_confirm: "You won't see this anymore. Are you sure?" } do |form| %>
  <%= form.hidden_field :is_accepted, value: false, required: true %>
  <%= form.button "Not interested anymore", class: "btn btn--secondary" %>
<% end %>
