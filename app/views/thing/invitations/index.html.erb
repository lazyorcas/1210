<%= render layout: "shared/modal", locals: { title: "Interests" } do %>
  <div class="mt-4 flex flex-col gap-y-4">
    <section class="flex flex-col gap-y-1">
      <header class="flex gap-x-2 items-center text-neutral-500">
        <%= heroicon "bookmark", options: { class: "h-4 w-4" } %>
        <h2 class="text-sm">Friends who find this interesting</h2>
      </header>
      <p>
        <%= @thing.interestees.count > 0 ? @thing.interestees.map(&:name).join(', ') : "No one yet" %>
      </p>
    </section>
    <%= render "form" %>
  </div>
<% end %>
