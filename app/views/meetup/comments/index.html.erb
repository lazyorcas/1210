<%= render ModalComponent.new(title: "Messages") do |component| %>
  <% component.with_body do %>
    <div class="px-4 modal-pb flex flex-col gap-y-8">
      <%= turbo_frame_tag "#{dom_id(@meetup)}_comments", class: "flex flex-col gap-y-4" do %>
        <%= render partial: "comments/comment", collection: @meetup_comments %>
      <% end %>
      <%= render partial: "comments/form", locals: { comment: Meetup::Comment.new } %>
    </div>
  <% end %>
<% end %>
