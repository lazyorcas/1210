<%= render layout: "shared/modal", locals: { title: "Messages" } do %>
  <div class="mt-4 flex flex-col gap-y-8">
    <%= turbo_frame_tag "#{dom_id(@meetup)}_comments", class: "flex flex-col gap-y-2" do %>
      <%= render partial: "comments/comment", collection: @meetup_comments %>
    <% end %>
    <%= render partial: "comments/form", locals: { comment: Meetup::Comment.new } %>
  </div>
<% end %>
