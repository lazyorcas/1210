<% if invitation.is_accepted.nil? %>
  <div class="flex flex-col gap-y-2">
    <%= form_with model: invitation do |form| %>
      <%= form.hidden_field :is_accepted, value: true, required: true %>
      <%= form.button :submit, class: "w-full btn btn--primary" do %>
        I'm in
      <% end %>
    <% end %>
    <%= form_with model: invitation do |form| %>
      <%= form.hidden_field :is_accepted, value: false, required: true %>
      <%= form.button :submit, class: "w-full btn" do %>
        I'm out
      <% end %>
    <% end %>
  </div>
<% elsif invitation.is_accepted %>
  <%= form_with model: invitation do |form| %>
    <%= form.hidden_field :is_accepted, value: false, required: true %>
    <%= form.button :submit, class: "w-full btn btn--secondary" do %>
      Cancel
    <% end %>
  <% end %>
<% else %>
  <%= form_with model: invitation do |form| %>
    <%= form.hidden_field :is_accepted, value: true, required: true %>
    <%= form.button :submit, class: "w-full btn btn--primary" do %>
      I'm in
    <% end %>
  <% end %>
<% end %>
