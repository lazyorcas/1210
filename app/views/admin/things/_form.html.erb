<%= form_with model: thing, url: thing.persisted? ? admin_thing_path(thing) : admin_things_path, class: "form-flow" do |form| %>
  <div class="form-inputs-flow">
    <div class="input-container">
      <%= form.label :type %>
      <%= form.select :type, Thing::TYPES, { include_blank: true }, class: "input select", required: true %>
    </div>
    <div class="input-container">
      <%= form.label :title %>
      <%= form.text_field :title, class: "input", required: true, maxlength: 255, autocomplete: "off" %>
    </div>
    <div class="input-container">
      <%= form.label :description %>
      <%= form.text_field :description, class: "input", maxlength: 255, autocomplete: "off" %>
    </div>
    <div class="input-container">
      <%= form.label :tags %>
      <%= form.text_field :tags, class: "input", maxlength: 255, autocomplete: "off" %>
    </div>
    <div class="input-container">
      <%= form.label :city %>
      <%= form.select :city, City.all, { include_blank: true }, class: "input select" %>
    </div>
    <div class="input-container">
      <%= form.label :url %>
      <%= form.text_field :url, class: "input", required: true, autocomplete: "off" %>
    </div>
    <div class="input-container">
      <%= form.label :image_url %>
      <%= form.text_field :image_url, class: "input", required: true, autocomplete: "off" %>
    </div>
  </div>
  <%= form.submit class: "btn btn--primary" %>
<% end %>
