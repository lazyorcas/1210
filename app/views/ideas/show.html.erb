<%= render ModalComponent.new(title: "Idea") do |component| %>
  <% component.with_toolbar do %>
    <% if @idea.thing.present? %>
      <%= link_to thing_path(@idea.thing), class: "icon-btn icon-btn--small", data: { turbo_frame: "modal" } do %>
        <%= heroicon "map-pin" %>
      <% end %>
    <% end %>
    <%= link_to idea_comments_path(@idea), class: "icon-btn icon-btn--small", data: { turbo_frame: "modal" } do %>
      <%= heroicon "chat-bubble-left-right" %>
    <% end %>
  <% end %>
  <% component.with_body do %>
    <article class="px-4 modal-pb flex flex-col gap-y-8">
      <header class="flex flex-col gap-y-1">
        <div>
          <h1 class="font-semibold"><%= @idea.title %></h1>
          <% if @idea.description.present? %>
            <p class="text-sm linkable"><%= auto_link(@idea.description, html: { target: '_blank' }) %></p>
          <% end %>
        </div>
        <% if @idea.polling? %>
          <%= render partial: "users/avatars", locals: { users: [@idea.organizer] + @idea.voters.sort_by(&:name), show_name: true } %>
        <% end %>
      </header>
      <% if @idea.looking_for_voters? %>
        <%= render partial: "invitees" %>
        <% if @idea.organizer == current_user %>
          <%= render partial: "looking_for_voters_message" %>
        <% end %>
      <% end %>
      <% if @idea.polling? %>
        <%= turbo_frame_tag "#{dom_id(@idea)}_options", class: "flex flex-col gap-y-4" do %>
          <%= render @idea.options.sorted_by_upvotes %>
        <% end %>
        <%= turbo_frame_tag "new_idea_option", src: new_idea_option_path(idea_id: @idea.id) %>
      <% end %>
      <% if @idea.organizer == current_user %>
        <div class="flex gap-x-2">
          <% if @idea.looking_for_voters? %>
            <%= button_to idea_path(@idea), method: :delete, class: "shrink-0 icon-btn btn--secondary", data: { turbo_confirm: "Are you sure you want to delete this idea?" } do |form| %>
              <%= heroicon "trash" %>
            <% end %>
            <%= link_to edit_idea_path(@idea), class: "shrink-0 icon-btn btn--secondary", data: { turbo_frame: "modal" } do %>
              <%= heroicon "pencil-square" %>
            <% end %>
            <%= render partial: "polling_button" %>
          <% elsif @idea.polling? %>
            <%= render partial: "polled_button" %>
          <% end %>
        </div>
      <% elsif @idea.looking_for_voters? %>
        <%= render partial: "idea/invitations/invitee_form", locals: { invitation: @idea.invitations.find_by(invitee: current_user) } %>
      <% end %>
    </article>
  <% end %>
<% end %>
