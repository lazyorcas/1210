<%= render layout: "shared/modal" do %>
  <article class="sm:w-[400px] flex flex-col gap-y-8">
    <header class="flex justify-between gap-x-4">
      <div>
        <h1 class="text-2xl font-bold"><%= @idea.title %></h1>
        <p>Suggested by <%= @idea.user.name %></p>
      </div>
      <%= render partial: "shared/modal_close_button" %>
    </header>
    <div class="flex flex-col gap-y-2">
      <section class="flex justify-between">
        <h2 class="text-neutral-500 w-[112px] shrink-0">Upvoted by</h2>
        <div class="flex gap-x-2">
          <%= heroicon "hand-thumb-up", options: { class: "shrink-0 h-6 w-6" } %>
          <p><%= @idea.upvoters.empty? ? "None" : @idea.upvoters.map(&:name).join(', ') %></p>
        </div>
      </section>
      <section class="flex justify-between">
        <h2 class="text-neutral-500 w-[112px] shrink-0">Haven't voted</h2>
        <div class="flex gap-x-2">
          <%= heroicon "question-mark-circle", options: { class: "shrink-0 h-6 w-6" } %>
          <p><%= @idea.pending_voters.empty? ? "None" : @idea.pending_voters.map(&:name).join(', ') %></p>
        </div>
      </section>
    </div>
    <% if @idea.user == current_user %>
      <div class="flex gap-x-4">
        <%= form_with model: @idea, class: "w-1/2", data: { turbo_confirm: "No one (including you) will be able to see or vote on this idea anymore. Are you sure?" } do |form| %>
          <%= form.hidden_field :is_done, value: true, required: true %>
          <%= form.button class: "w-full btn btn--primary" do %>
            Mark as done
          <% end %>
        <% end %>
        <%= link_to edit_idea_path(@idea), class: "w-1/2 btn btn--secondary", data: { turbo_frame: "modal" } do %>
          Edit
        <% end %>
      </div>
    <% else %>
      <%= render partial: "ideas/invitations/invitee_form", locals: { invitation: @idea.invitations.find_by(invitee: current_user) } %>
    <% end %>
  </article>
<% end %>
