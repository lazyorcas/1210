<% if !invitation.is_accepted || invitation.is_accepted.nil? %>
  <%= form_with model: invitation, url: ideas_invitation_path(invitation) do |form| %>
    <%= form.hidden_field :is_accepted, value: true, required: true %>
    <%= form.button :submit, class: "icon-btn btn--primary" do %>
      <%= heroicon "hand-thumb-up", options: { class: "h-6 w-6" } %>
    <% end %>
  <% end %>
<% end %>
<% if invitation.is_accepted || invitation.is_accepted.nil? %>
  <%= form_with model: invitation, url: ideas_invitation_path(invitation) do |form| %>
    <%= form.hidden_field :is_accepted, value: false, required: true %>
    <%= form.button :submit, class: "icon-btn btn--secondary" do %>
      <%= heroicon "hand-thumb-down", options: { class: "h-6 w-6" } %>
    <% end %>
  <% end %>
<% end %>
