<% is_voter_or_owner = idea.voters.exists?(current_user.id) || idea.organizer == current_user %>
<article class="flex flex-col gap-y-0.5" id="<%= dom_id(idea) %>">
  <div class="card flex gap-x-4">
    <%= link_to idea_path(idea), class: "grow", data: { turbo_frame: "modal" } do %>
      <p class="text-sm"><%= idea.organizer.name %></p>
      <div>
        <h2 class="font-semibold"><%= idea.title %></h2>
        <% if idea.description.present? %>
          <p class="line-clamp-2 text-sm"><%= idea.description %></p>
        <% end %>
      </div>
    <% end %>
    <div class="shrink-0 flex flex-col items-end">
      <% if idea.polling? && is_voter_or_owner %>
        <div class="flex items-center gap-x-1">
          <span class="rounded-full h-2 w-2 bg-green-500"></span>
          <p class="text-sm">
            Planning
          </p>
        </div>
      <% end %>
      <% if idea.looking_for_voters? && idea.organizer != current_user %>
        <div class="flex items-center gap-x-1 text-sm">
          <%= heroicon "heart", variant: is_voter_or_owner ? :solid : :outline, options: { class: class_names("h-4 w-4", { "text-red-500": is_voter_or_owner }) } %>
          <%= idea.voters.count %>
        </div>
      <% end %>
      <%= link_to idea_comments_path(idea), class: "flex items-center gap-x-1 text-sm", data: { turbo_frame: "modal" } do %>
        <%= heroicon "chat-bubble-left-right", options: { class: "h-4 w-4" } %>
        <%= idea.comments.count %>
      <% end %>
    </div>
  </div>
  <% if idea.organizer == current_user && idea.looking_for_voters? %>
    <aside class="px-4 flex self-end items-center gap-x-1 text-xs text-neutral-500">
      <p class="flex items-center gap-x-0.5">
        <%= heroicon "heart", options: { class: "h-3.5 w-3.5" } %>
        <%= idea.voters.count %>
      </p>
      /
      <p class="flex items-center gap-x-0.5">
        <%= heroicon "eye", options: { class: "h-3.5 w-3.5" } %>
        <%= idea.seen_invitees.count %>
      </p>
      /
      <p class="flex items-center gap-x-0.5">
        <%= heroicon "envelope", options: { class: "h-3.5 w-3.5" } %>
        <%= idea.invitees.count %>
      </p>
    </aside>
  <% end %>
</article>
