<article class="flex flex-col gap-y-0.5" id="<%= dom_id(idea) %>">
  <%= link_to idea_path(idea), class: "relative card card--clickable flex flex-col gap-y-2", data: { turbo_frame: "modal" } do %>
    <% if idea.polling? %>
      <span class="absolute top-0 right-0 -mt-1 -mr-1 w-3 h-3 bg-green-500"></span>
    <% end %>
    <header class="flex flex-col">
      <h2 class="font-semibold"><%= idea.title %></h2>
      <% if idea.description.present? %>
        <p class="text-sm line-clamp-2"><%= idea.description %></p>
      <% end %>
    </header>
    <%= render partial: "users/avatars", locals: { users: [idea.organizer] + idea.voters.sort_by(&:name) } %>
  <% end %>
  <aside class="self-end pr-4 flex items-center gap-x-1 text-xs text-neutral-500">
    <% if idea.organizer == current_user %>
      <p class="flex items-center gap-x-0.5">
        <%= heroicon "heart", options: { class: "h-3.5 w-3.5" } %>
        <%= idea.voters.count %>
      </p>
    <% else %>
      <% invitation = current_user.idea_invitations.find_by(inviter: idea) %>
      <%= form_with model: invitation, class: "self-end" do |form| %>
        <%= form.hidden_field :is_accepted, value: !invitation.is_accepted, required: true %>
        <%= form.button :submit, class: "flex items-center gap-x-0.5" do %>
          <%= heroicon "heart", variant: invitation.is_accepted ? "solid" : "outline", options: { class: class_names("h-3.5 w-3.5", { "text-red-500": invitation.is_accepted }) } %>
          <%= idea.voters.count %>
        <% end %>
      <% end %>
    <% end %>
    <%= link_to idea_comments_path(idea), class: "flex items-center gap-x-0.5", data: { turbo_frame: "modal" } do %>
      <%= heroicon "chat-bubble-left-right", options: { class: "h-3.5 w-3.5" } %>
      <%= idea.comments.count %>
    <% end %>
    <% if idea.organizer == current_user %>
      <p class="flex items-center gap-x-0.5">
        <%= heroicon "eye", options: { class: "h-3.5 w-3.5" } %>
        <%= idea.seen_invitees.count %>
      </p>
      /
      <p class="flex items-center gap-x-0.5">
        <%= heroicon "envelope", options: { class: "h-3.5 w-3.5" } %>
        <%= idea.invitees.count %>
      </p>
    <% end %>
  </aside>
</article>
