<article class="flex flex-col gap-y-0.5" id="<%= dom_id(idea) %>">
  <%= link_to idea_path(idea), class: "card flex gap-x-4", data: { turbo_frame: "modal" } do %>
    <div class="grow">
      <p class="text-sm"><%= idea.user.name %></p>
      <div>
        <h2 class="font-semibold"><%= idea.title %></h2>
        <% if idea.description.present? %>
          <p class="text-sm"><%= idea.description %></p>
        <% end %>
      </div>
    </div>
    <div class="shrink-0 flex flex-col items-end">
      <% if idea.voters.exists?(current_user.id) || idea.user == current_user %>
        <div class="flex items-center gap-x-1">
          <span class="<%= class_names("rounded-full h-2 w-2", idea.polling? ? "bg-green-500": "bg-amber-500" ) %>"></span>
          <p class="text-sm">
            <% if idea.polling? %>
              Planning
            <% else %>
              Interested
            <% end %>
          </p>
        </div>
      <% end %>
      <% if idea.looking_for_voters? %>
        <div class="flex items-center gap-x-1 text-sm">
          <%= heroicon "heart", options: { class: "h-4 w-4" } %>
          <%= idea.voters.count %>
        </div>
      <% end %>
    </div>
  <% end %>
  <% if idea.user == current_user && idea.looking_for_voters? %>
    <aside class="px-4 flex self-end items-center gap-x-1 text-xs text-neutral-500">
      <p class="flex items-center gap-x-0.5">
        <%= heroicon "eye", options: { class: "h-3.5 w-3.5" } %>
        <%= idea.seen_invitees.count %>
      </p>
      /
      <p class="flex items-center gap-x-0.5">
        <%= heroicon "envelope", options: { class: "h-3.5 w-3.5" } %>
        <%= idea.invitees.count %>
      </p>
    </aside>
  <% end %>
</article>
