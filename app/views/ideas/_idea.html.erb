<% current_user_upvoted = idea.upvoters.exists?(current_user.id) %>
<%= link_to idea_path(idea), class: "card flex gap-x-4", id: dom_id(idea), data: { turbo_frame: "modal" } do %>
  <div class="grow">
    <p class="text-sm"><%= idea.user.name %></p>
    <h2 class="font-semibold"><%= idea.title %></h2>
    <p class="text-xs text-neutral-500"><%= time_ago_in_words(idea.created_at, highest_measures: 1) %> ago</p>
  </div>
  <div class="shrink-0 flex flex-col items-end">
    <% if current_user_upvoted %>
      <div class="flex items-center gap-x-1">
        <span class="rounded-full bg-green-400 h-2 w-2"></span>
        <p class="text-sm">Upvoted</p>
      </div>
    <% end %>
    <div class="flex items-center gap-x-1 text-sm">
      <%= heroicon "hand-thumb-up", options: { class: "h-4 w-4" } %>
      <%= idea.upvoters.length %>/<%= idea.invitees.length %>
    </div>
  </div>
<% end %>
