<%= form_with model: idea, class: "form-flow" do |form| %>
  <%= form.hidden_field :thing_id %>
  <div class="form-inputs-flow">
    <%= form.text_field :title, class: "line-input text-xl mb-2", required: true, placeholder: "Untitled", autocomplete: "off" %>
    <div class="input-container">
      <%= form.label :description %>
      <%= form.text_field :description, placeholder: "details, if any", class: "input", autocomplete: "off" %>
    </div>
    <div class="input-container">
      <div>
        <%= form.label :invitee_ids do %>
          Who can vote?
        <% end %>
        <p class="text-sm text-neutral-400">Leave it empty to let all of your friends vote.</p>
      </div>
      <%= form.collection_select :invitee_ids, idea.organizer.friends_in_the_same_city.order(:name), :id, :name, {}, { multiple: true } %>
    </div>
  </div>
  <%= form.button :submit, class: "btn btn--primary" %>
<% end %>
