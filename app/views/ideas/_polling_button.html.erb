<%= form_with model: @idea, class: "grow" do |form| %>
  <%= form.hidden_field :status, value: :polling, required: true %>
  <%= form.button class: "w-full btn btn--primary", disabled: @idea.voters.empty?, data: { turbo_confirm: "People who are not interested won't be able to see this idea anymore. Are you sure?" } do %>
    Start polling
  <% end %>
<% end %>
