<main class="social-network__main">
  <%= turbo_frame_tag "memories", class: "flex flex-col gap-y-2" do %>
    <% if @memories.empty? %>
      <%= turbo_frame_tag "memories-header" do %>
        <%= render partial: "no_memories" %>
      <% end %>
    <% else %>
      <%= render @memories %>
    <% end %>
  <% end %>
</main>
