<%= link_to memory_path(memory), class: "polaroid polaroid--clickable", data: { turbo_frame: "modal" }, id: dom_id(memory) do %>
  <% if memory.photos.present? %>
    <div class="relative">
      <%= image_tag photo_path(id: memory.photos.sample.id), class: "w-full thumbnail rounded-t-xl bg-neutral-200" %>
      <div class="absolute top-2 right-2 flex items-center gap-x-1 bg-white rounded-xl px-2 py-1 text-sm">
        <%= heroicon "photo", options: { class: "h-4 w-4" } %>
        <%= memory.photos.count %>
      </div>
    </div>
  <% end %>
  <div class="polaroid__content">
    <p class="text-sm text-neutral-500">
      <%= past_date(memory.meetup.date) %>
    </p>
    <h2 class="font-bold mb-2"><%= memory.meetup.title %></h2>
    <%= render partial: "users/avatars", locals: { users: [memory.meetup.organizer] +  memory.meetup.attendees.sort_by(&:name), show_name: true } %>
  </div>
<% end %>
