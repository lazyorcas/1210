<%= form_with model: @memory, class: "flex flex-col items-center gap-y-4", data: { controller: "uploader" } do |form| %>
  <% @memory.photos.each do |photo| %>
    <%= form.hidden_field :photos, multiple: true, value: photo.signed_id %>
  <% end %>
  <%= form.file_field :photos, multiple: true, required: true, accept: 'image/*', class: "w-full" %>
  <%= form.button class: "w-full btn btn--primary btn--with-icon", data: { uploader_target: "uploadBtn" } do %>
    <%= heroicon "cloud-arrow-up", variant: "solid" %>
    Upload
  <% end %>
<% end %>
