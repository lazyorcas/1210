<%= render ModalComponent.new(title: "Photos") do |component| %>
  <% component.with_body do %>
    <div class="px-4 modal-pb flex flex-col gap-y-4">
      <%= render partial: "users/avatars", locals: { users: [@memory.meetup.organizer] +  @memory.meetup.attendees.sort_by(&:name), show_name: true } %>
      <%= turbo_frame_tag "photos" do %>
        <% if @memory.photos.empty? %>
          <%= render partial: "no_photos" %>
        <% else %>
          <%= render partial: "photos", locals: { photos: @memory.photos } %>
        <% end %>
      <% end %>
      <div class="pt-4 border-t">
        <%= render partial: "form" %>
      </div>
    </div>
  <% end %>
<% end %>
