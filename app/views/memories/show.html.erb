<%= render layout: "shared/modal", locals: { title: "Photos" } do %>
  <div class="flex flex-col gap-y-4">
    <p class="text-sm">
      <%= ([@memory.meetup.organizer] +  @memory.meetup.attendees).map(&:name).join(', ') %>
    </p>
    <%= turbo_frame_tag "photos" do %>
      <% if @memory.photos.empty? %>
        <%= render partial: "no_photos" %>
      <% else %>
        <%= render partial: "photos", locals: { photos: @memory.photos } %>
      <% end %>
    <% end %>
    <div class="sm:sticky sm:-bottom-4 pt-4 sm:pb-4 bg-white border-t">
      <%= render partial: "form" %>
    </div>
  </div>
<% end %>
