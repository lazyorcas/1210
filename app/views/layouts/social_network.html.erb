<!DOCTYPE html>
<html>
  <%= render "shared/head" %>
  <body>
    <header class="py-4 flex items-center gap-x-4 justify-between">
      <h1 class="shrink-0 text-4xl font-black inline-flex">
        <%= yield :page_title %>
      </h1>
      <nav class="flex gap-x-2">
        <%= link_to user_invitations_path, class: "icon-btn" do %>
          <%= heroicon "users", options: { class: "h-6 w-6" } %>
        <% end %>
      </nav>
    </header>
    <% if @date.present? %>
      <nav class="shrink-0 border-b flex w-full gap-x-4">
        <%= render layout: "shared/date_tab", locals: { path: request.params.merge(date: Time.zone.today), active: @date == Time.zone.today } do %>
          Today
        <% end %>
        <%= render layout: "shared/date_tab", locals: { path: request.params.merge(date: Time.zone.today + 1.day), active: @date == Time.zone.today + 1.day } do %>
          Tomorrow
        <% end %>
      </nav>
    <% end %>
    <%= yield %>
    <%= turbo_frame_tag "modal" %>
    <nav class="bottom-nav">
      <%= render layout: "shared/page_tab", locals: { icon_name: "calendar-days", path: plans_path(date: @date || Time.zone.today) } do %>
        Plans
      <% end %>
      <%= render layout: "shared/page_tab", locals: { icon_name: "bolt", path: meetups_path(date: @date || Time.zone.today) } do %>
        Meetups
      <% end %>
    </nav>
  </body>
</html>
