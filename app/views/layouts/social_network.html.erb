<!DOCTYPE html>
<html>
  <%= render "shared/head" %>
  <body>
    <header class="h-[76px] py-4 flex items-center gap-x-4 justify-between">
      <div class="flex items-center gap-x-2">
        <h1 class="shrink-0 text-4xl font-black inline-flex">
          <%= yield :page_title %>
        </h1>
        <% if content_for?(:help_path) %>
          <%= link_to yield(:help_path) , data: { turbo_frame: "modal" } do %>
            <%= heroicon "information-circle", options: { class: "h-6 w-6" } %>
          <% end %>
        <% end %>
      </div>
      <div class="flex items-center gap-x-4">
        <% if content_for?(:toolbar) %>
          <%= yield :toolbar %>
        <% end %>
      </div>
    </header>
    <hr />
    <%= yield %>
    <%= turbo_frame_tag "modal" %>
    <%= render partial: "shared/page_tabs" %>
  </body>
</html>
