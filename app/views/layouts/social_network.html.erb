<!DOCTYPE html>
<html>
  <%= render "shared/head" %>
  <body>
    <header class="shrink-0 h-[68px] flex items-center gap-x-4 justify-between">
      <div class="flex items-center gap-x-1">
        <h1 class="shrink-0 text-3xl font-black inline-flex">
          <%= yield :page_title %>
        </h1>
        <% if content_for?(:help_path) %>
          <%= link_to yield(:help_path), class: "icon-btn icon-btn--small", data: { turbo_frame: "modal" } do %>
            <%= heroicon "information-circle", options: { class: "h-6 w-6" } %>
          <% end %>
        <% end %>
      </div>
      <div class="flex items-center gap-x-4">
        <%= link_to download_path, class: "icon-btn icon-btn--small standalone:hidden", data: { turbo_frame: "modal" } do %>
          <%= heroicon "arrow-down-tray", options: { class: "h-6 w-6" } %>
        <% end %>
        <% if content_for?(:toolbar) %>
          <%= yield :toolbar %>
        <% end %>
      </div>
    </header>
    <hr />
    <%= yield %>
    <%= turbo_frame_tag "modal" %>
    <%= render partial: "shared/page_tabs" %>
  </body>
</html>
