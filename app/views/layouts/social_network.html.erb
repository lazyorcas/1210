<!DOCTYPE html>
<html>
  <%= render "shared/head" %>
  <body class="social-network__body">
    <header class="social-network__header">
      <div class="flex items-center gap-x-1">
        <h1 class="shrink-0 text-3xl font-black">
          <%= yield :page_title %>
        </h1>
      </div>
      <% if content_for?(:toolbar) %>
        <div class="flex items-center gap-x-2">
          <%= yield :toolbar %>
        </div>
      <% end %>
    </header>
    <%= yield %>
    <%= turbo_frame_tag "modal", src: @default_modal_src, target: "_top" %>
    <%= render partial: "shared/page_tabs" %>
  </body>
</html>
