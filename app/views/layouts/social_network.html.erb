<!DOCTYPE html>
<html>
  <%= render "shared/head" %>
  <body>
    <header class="py-4 flex items-center gap-x-4 justify-between">
      <h1 class="shrink-0 text-4xl font-black inline-flex">
        <%= yield :page_title %>
      </h1>
      <nav class="flex gap-x-2">
        <% if browser.device.mobile? %>
          <%= link_to install_path, class: "icon-btn standalone:hidden", data: { turbo_frame: "modal" } do %>
            <%= heroicon "arrow-down-tray", options: { class: "h-6 w-6" } %>
          <% end %>
        <% end %>
        <button class="icon-btn hidden standalone:hidden" data-controller="notification-permission" data-action="notification-permission#request">
          <%= heroicon "bell-alert", options: { class: "h-6 w-6" } %>
        </button>
        <%= link_to user_invitations_path, class: "icon-btn relative" do %>
          <%= heroicon "users", options: { class: "h-6 w-6" } %>
          <% if current_user.received_invitations.pending.present? %>
            <div class="text-xs absolute right-0 top-0 bg-red-500 text-white rounded-full w-5 h-5 flex items-center justify-center font-bold">
              <%= current_user.received_invitations.pending.count %>
            </div>
          <% end %>
        <% end %>
      </nav>
    </header>
    <hr />
    <%= yield %>
    <%= turbo_frame_tag "modal" %>
    <nav class="bottom-nav">
      <%= render layout: "shared/page_tab", locals: { icon_name: "bolt", path: meetups_path } do %>
        Meetups
      <% end %>
      <%= render layout: "shared/page_tab", locals: { icon_name: "photo", path: memories_path } do %>
        Memories
      <% end %>
      <%= render layout: "shared/page_tab", locals: { icon_name: "queue-list", path: ideas_path } do %>
        Ideas
      <% end %>
      <%= render layout: "shared/page_tab", locals: { icon_name: "users", path: user_invitations_path } do %>
        Friends
      <% end %>
    </nav>
  </body>
</html>
