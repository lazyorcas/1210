<!DOCTYPE html>
<html>
  <%= render "shared/head" %>
  <body>
    <header class="h-[76px] py-4 flex items-center gap-x-4 justify-between">
      <h1 class="shrink-0 text-4xl font-black inline-flex">
        <%= yield :page_title %>
      </h1>
      <nav class="flex gap-x-2 items-center">
        <% if content_for?(:toolbar) %>
          <%= yield :toolbar %>
        <% end %>
      </nav>
    </header>
    <hr />
    <%= yield %>
    <%= turbo_frame_tag "modal" %>
    <nav class="bottom-nav">
      <%= render layout: "shared/page_tab", locals: { icon_name: "photo", path: memories_path } do %>
        Memories
      <% end %>
      <%= render layout: "shared/page_tab", locals: { icon_name: "heart", path: ideas_path } do %>
        Ideas
      <% end %>
      <%= render layout: "shared/page_tab", locals: { icon_name: "bolt", path: meetups_path } do %>
        Meetups
      <% end %>
      <%= render layout: "shared/page_tab", locals: { icon_name: "users", path: user_invitations_path } do %>
        Friends
        <% if current_user.received_invitations.pending.count > 0 %>
          <div class="text-xs absolute -mr-8 -mt-12 bg-red-500 text-white rounded-full w-5 h-5 flex items-center justify-center font-bold">
            <%= current_user.received_invitations.pending.count %>
          </div>
        <% end %>
      <% end %>
      <%= render layout: "shared/page_tab", locals: { icon_name: "cog-8-tooth", path: user_settings_path } do %>
        Settings
      <% end %>
    </nav>
  </body>
</html>
