<!DOCTYPE html>
<html>
  <head>
    <title>Catch Up</title>
    <meta name="description" content="Set reminder for yourself to talk to your friends.">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="manifest" crossorigin="use-credentials" href="/catch_up/manifest.json">
    <link rel="apple-touch-icon" sizes="180x180" href="/catch_up/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/catch_up/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/catch_up/favicon-32x32.png">
    <%= favicon_link_tag "/catch_up/favicon.ico" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= preload_link_tag "Inter.ttf", as: "font", type: "font/ttf" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <% if current_user %>
      <%= render partial: "shared/push_subscription" %>
    <% end %>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
