<!DOCTYPE html>
<html>
  <%= render "shared/head" %>
  <body class="px-0">
    <header class="shrink-0 h-[68px] flex items-center gap-x-4 px-4 justify-between">
      <div class="flex items-center gap-x-1">
        <%= link_to ideas_path, class: "icon-btn icon-btn--small" do %>
          <%= heroicon "chevron-left", options: { class: "h-6 w-6" } %>
        <% end %>
        <h1 class="text-3xl font-black"><%= current_user.city %></h1>
      </div>
      <nav class="flex items-center gap-x-2">
        <% if current_page?(all_things_path) %>
          <%= link_to new_thing_path, class: "icon-btn btn--primary", data: { turbo_frame: "modal" } do %>
            <%= heroicon "plus", options: { class: "h-6 w-6" } %>
          <% end %>
        <% else %>
          <%= link_to current_page?(interesting_things_path) ? things_path : interesting_things_path, class: "icon-btn icon-btn--small" do %>
            <%= heroicon "bookmark", variant: current_page?(interesting_things_path) ? "solid" : "outline", options: { class: "h-6 w-6" } %>
          <% end %>
        <% end %>
      </nav>
    </header>
    <%= yield %>
    <%= turbo_frame_tag "modal" do %>
      <% if !current_page?(interesting_things_path) && current_user.disinterests.count == 0 %>
        <%= render partial: "things/guide" %>
      <% end %>
    <% end %>
  </body>
</html>
