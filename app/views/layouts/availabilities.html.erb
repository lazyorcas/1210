<!DOCTYPE html>
<html>
  <%= render "shared/head" %>
  <body>
    <header class="shrink-0 h-[68px] flex items-center gap-x-1 px-4">
      <%= link_to current_user_friends_path, class: "icon-btn icon-btn--small" do %>
        <%= heroicon "chevron-left", options: { class: "h-6 w-6" } %>
      <% end %>
      <h1 class="text-3xl font-black">Who's up?</h1>
    </header>
    <%= yield %>
    <%= turbo_frame_tag "modal", target: "_top" %>
  </body>
</html>
