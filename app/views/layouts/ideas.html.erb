<% content_for :page_title, "Ideas" %>
<% content_for :toolbar do %>
  <%= link_to things_path, class: "icon-btn icon-btn--small" do %>
    <%= heroicon "map-pin", options: { class: "h-6 w-6" } %>
    <% if Thing.pending(current_user).count > 0 %>
      <div class="status status--empty absolute -mr-6 -mt-6"></div>
    <% end %>
  <% end %>
  <%= link_to new_idea_path, class: "icon-btn btn--primary", data: { turbo_frame: "modal" } do %>
    <%= heroicon "plus", options: { class: "h-6 w-6" } %>
  <% end %>
<% end %>
<% content_for :help_path, help_ideas_path %>
<%= render template: "layouts/social_network" %>
