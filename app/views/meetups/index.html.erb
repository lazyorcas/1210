<main class="grow w-full flex flex-col gap-y-4 pt-4 pb-[84px] standalone:pb-[120px]">
  <% if @date_meetups.empty? %>
    <%= render partial: "no_meetups" %>
  <% end %>
  <div class="flex flex-col gap-y-4">
    <% @date_meetups.each do |date, meetups| %>
      <section class="flex flex-col gap-y-2">
        <h2 class="text-lg font-semibold">
          <%= meetups.first.relative_day %>
        </h2>
        <%= render meetups %>
      </section>
    <% end %>
  </div>
</main>
<% if current_user.friends.empty? %>
  <%= turbo_frame_tag "modal", src: user_path(current_user) %>
<% end %>
