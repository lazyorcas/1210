<% content_for :page_title, "Meetups" %>
<% content_for :toolbar do %>
  <%= link_to new_meetup_path, class: "icon-btn btn--primary", data: { turbo_frame: "modal" } do %>
    <%= heroicon "plus", variant: "solid" %>
  <% end %>
<% end %>
<main class="social-network__main">
  <nav class="flex gap-x-1">
    <%= link_to meetups_path, class: class_names("chip flex items-center", params[:filter] ? "chip-tab--inactive" : "chip-tab--active") do %>
      Upcoming
    <% end %>
    <%= link_to meetups_path(filter: "declined"), class: class_names("chip flex items-center", params[:filter] == "declined" ? "chip-tab--active" : "chip-tab--inactive") do %>
      Declined
    <% end %>
  </nav>
  <% if @meetups.empty? %>
    <% if params[:filter].present? %>
      <%= render partial: "shared/nothing_here" %>
    <% else %>
      <%= render partial: "no_meetups" %>
    <% end %>
  <% else %>
    <% @date_meetups_pairs.each do |date, meetups| %>
      <section class="flex flex-col gap-y-2">
        <h2 class="font-bold">
          <%= relative_to_today(meetups.first.date) %>
        </h2>
        <div class="flex flex-col gap-y-4">
          <%= render meetups %>
        </div>
      </section>
    <% end %>
  <% end %>
</main>
