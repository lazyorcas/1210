<%= render partial: "shared/date_tabs" %>
<main class="grow w-full flex flex-col gap-y-4 pt-4 pb-[84px] standalone:pb-24">
  <%= turbo_frame_tag "meetups_summary" do %>
    <% if @meetups.empty? %>
      No one has said anything yet.
    <% else %>
      What are you up to?
    <% end %>
  <% end %>
  <%= link_to new_meetup_path, class: "btn btn--primary w-fit gap-x-2", data: { turbo_frame: "modal" } do %>
    <%= heroicon "pencil-square", options: { class: "h-6 w-6" } %>
    Post
  <% end %>
  <%= turbo_frame_tag "meetups", class: "flex flex-col gap-y-2" do %>
    <%= render @meetups %>
  <% end %>
</main>
<% if current_user.friends.empty? %>
  <%= turbo_frame_tag "modal", src: user_path(current_user) %>
<% end %>
