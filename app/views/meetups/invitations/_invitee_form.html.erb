<% if invitation.is_accepted %>
  <%= form_with model: invitation, url: meetups_invitation_path(invitation), method: :patch do |form| %>
    <%= form.hidden_field :is_accepted, value: false, required: true %>
    <%= form.button :submit, class: "btn btn--secondary" do %>
      Cancel
    <% end %>
  <% end %>
<% else %>
  <%= form_with model: invitation, url: meetups_invitation_path(invitation), method: :patch do |form| %>
    <%= form.hidden_field :is_accepted, value: true, required: true %>
    <%= form.button :submit, class: "btn btn--primary" do %>
      I'm in
    <% end %>
  <% end %>
<% end %>
