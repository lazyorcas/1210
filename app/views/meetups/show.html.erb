<%= render ModalComponent.new(title: "Meetup") do |component| %>
  <% component.with_toolbar do %>
    <% if @meetup.thing.present? %>
      <%= link_to thing_path(@meetup.thing), class: "icon-btn icon-btn--small", data: { turbo_frame: "modal" } do %>
        <%= heroicon "map-pin" %>
      <% end %>
    <% end %>
    <%= link_to meetup_comments_path(@meetup), class: "icon-btn icon-btn--small", data: { turbo_frame: "modal" } do %>
      <%= heroicon "chat-bubble-left-right" %>
    <% end %>
  <% end %>
  <% component.with_body do %>
    <article class="px-4 modal-pb flex flex-col gap-y-8">
      <header class="flex flex-col gap-y-2">
        <div>
          <h1 class="font-semibold"><%= @meetup.title %></h1>
          <p class="text-sm text-neutral-500"><%= relative_to_today(@meetup.date) %>, <%= @meetup.start_time  %> - <%= @meetup.end_time  %></p>
        </div>
        <% if @meetup.description.present? %>
          <p class="text-sm linkable"><%= auto_link(@meetup.description, html: { target: '_blank' }) %></p>
        <% end %>
      </header>
      <div class="flex flex-col gap-y-4">
        <section class="flex flex-col gap-y-1">
          <div class="flex items-center gap-x-1 text-neutral-500">
            <%= heroicon "bolt", options: { class: "h-4 w-4" } %>
            <h2 class="text-sm">Who's in?</h2>
          </div>
          <p class="text-sm">
            <%= render partial: "users/avatars", locals: { users: [@meetup.organizer] + @meetup.attendees.sort_by(&:name), show_name: true } %>
          </p>
        </section>
        <% if @meetup.declined_invitees.present? %>
          <section class="flex flex-col gap-y-1">
            <div class="flex items-center gap-x-1 text-neutral-500">
              <%= heroicon "face-frown", options: { class: "h-4 w-4" } %>
              <h2 class="text-sm">Who's out?</h2>
            </div>
            <p class="text-sm">
              <%= render partial: "users/avatars", locals: { users: @meetup.declined_invitees.sort_by(&:name), show_name: true } %>
            </p>
          </section>
        <% end %>
      </div>
      <% if @meetup.organizer == current_user %>
        <div class="flex items-center gap-x-2">
          <%= button_to meetup_path(@meetup), method: :delete, class: "icon-btn icon-btn--small", data: { turbo_confirm: "Are you sure you want to delete this meetup?" } do |form| %>
            <%= heroicon "trash" %>
          <% end %>
          <%= link_to edit_meetup_path(@meetup), class: "grow btn btn--secondary", data: { turbo_frame: "modal" } do %>
            Edit
          <% end %>
        </div>
      <% else %>
        <%= render partial: "meetup/invitations/invitee_form", locals: { invitation: @meetup.invitations.find_by(invitee: current_user) } %>
      <% end %>
    </article>
  <% end %>
<% end %>
