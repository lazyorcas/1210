<%= render ModalComponent.new do |component| %>
  <% component.with_toolbar do %>
    <%= link_to meetup_comments_path(@meetup), data: { turbo_frame: "modal" } do %>
      <%= heroicon "chat-bubble-left-right", options: { class: "h-6 w-6" } %>
    <% end %>
  <% end %>
  <% component.with_body do %>
    <article class="px-4 modal-pb flex flex-col gap-y-8">
      <header>
        <h1 class="text-lg font-bold"><%= @meetup.title %></h1>
        <p class="text-sm linkable"><%= auto_link(@meetup.description, html: { target: '_blank' }) %></p>
      </header>
      <div class="flex flex-col gap-y-4">
        <section class="flex flex-col gap-y-1">
          <header class="flex gap-x-2 items-center text-neutral-500">
            <%= heroicon "users", options: { class: "h-4 w-4" } %>
            <h2 class="text-sm">Who's going?</h2>
          </header>
          <p class="text-sm">
            <%= render partial: "users/avatars", locals: { users: ([@meetup.organizer] + @meetup.attendees), show_name: true } %>
          </p>
        </section>
        <section class="flex flex-col gap-y-1">
          <header class="flex gap-x-2 items-center text-neutral-500">
            <%= heroicon "clock", options: { class: "h-4 w-4" } %>
            <h2 class="text-sm">Date & Time</h2>
          </header>
          <p class="text-sm">
            <%= @meetup.date.strftime("%B #{@meetup.date.day.ordinalize}") %>,
            <%= @meetup.start_time  %> - <%= @meetup.end_time  %>
          </p>
        </section>
      </div>
      <% if @meetup.organizer == current_user %>
        <div class="flex gap-x-2">
          <%= button_to meetup_path(@meetup), method: :delete, class: "icon-btn btn--secondary", data: { turbo_confirm: "Are you sure you want to delete this meetup?" } do |form| %>
            <%= heroicon "trash", options: { class: "h-6 w-6" } %>
          <% end %>
          <%= link_to edit_meetup_path(@meetup), class: "grow btn btn--secondary", data: { turbo_frame: "modal" } do %>
            Edit
          <% end %>
        </div>
      <% else %>
        <%= render partial: "meetup/invitations/invitee_form", locals: { invitation: @meetup.invitations.find_by(invitee: current_user) } %>
      <% end %>
    </article>
  <% end %>
<% end %>
