<%= form_with model: meetup, class: 'form-flow sm:w-[400px]' do |form| %>
  <div class="form-inputs-flow">
    <%= form.text_field :title, list: "titles", class: "grow line-input my-2", required: true, placeholder: "Untitled", autocomplete: "off" %>
    <datalist id="titles">
      <% Meetup::Title.all.each do |title| %>
        <option value="<%= title %>"></option>
      <% end %>
    </datalist>
    <div class="input-container">
      <%= form.label :description %>
      <%= form.text_field :description, placeholder: "give details on location, preferences, …", class: "input", autocomplete: "off" %>
    </div>
    <div class="input-container">
      <div>When?</div>
      <div class="flex items-center gap-x-2">
        <%= form.time_field :start_time, value: meetup.start_time, required: true, class: "flex-1 input" %>
        -
        <%= form.time_field :end_time, value: meetup.end_time, required: true, class: "flex-1 input" %>
      </div>
    </div>
  </div>
  <%= form.submit "Let your friends know", class: "btn btn--primary" %>
<% end %>
