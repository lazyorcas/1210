<%= form_with model: meetup, class: "form-flow" do |form| %>
  <%= form.hidden_field :thing_id %>
  <div class="form-inputs-flow">
    <%= form.text_field :title, class: "line-input text-xl mb-2", required: true, placeholder: "Untitled", autocomplete: "off", maxlength: 30 %>
    <div class="input-container">
      <%= form.label :description %>
      <%= form.text_field :description, placeholder: "enter an option…", class: "input", autocomplete: "off" %>
    </div>
    <div class="input-container">
      <div>
        <%= form.label :date %>
        <p class="text-sm text-neutral-400">Default to today.</p>
      </div>
      <%= form.date_field :date, value: meetup.date || Time.zone.today, min: Time.zone.today, class: "input", autocomplete: "off" %>
    </div>
    <div class="input-container">
      <div>Time</div>
      <div class="flex items-center gap-x-2">
        <%= form.time_field :start_time, value: meetup.start_time, required: true, class: "flex-1 input" %>
        -
        <%= form.time_field :end_time, value: meetup.end_time, required: true, class: "flex-1 input" %>
      </div>
    </div>
    <div class="input-container">
      <div>
        <%= form.label :invitee_ids do %>
          Whom is it visible to?
        <% end %>
        <p class="text-sm text-neutral-400">Leave it empty to share with all your friends.</p>
      </div>
      <%= form.collection_select :invitee_ids, meetup.organizer.friends.order(:name), :id, :name, {}, { multiple: true } %>
    </div>
  </div>
  <%= form.button :submit, class: "btn btn--primary" %>
<% end %>
