<article class="card flex gap-x-4" id="<%= dom_id meetup %>">
  <div class="grow flex flex-col gap-y-2">
    <div>
      <p class="text-sm"><%= [meetup.organizer.name, meetup.attendees.map(&:name)].flatten.join(', ') %></p>
      <p class="text-sm"><%= meetup.start_time  %> - <%= meetup.end_time  %></p>
    </div>
    <h2 class="text-xl font-bold"><%= meetup.title %></h2>
    <% if meetup.description.present? %>
      <p><%= meetup.description %></p>
    <% end %>
  </div>
  <aside class="shrink-0 flex flex-col gap-y-4 items-end justify-between">
    <% if meetup.organizer_id == current_user.id %>
      <%= button_to meetup_path(id: meetup.id), method: :delete, class: "icon-btn", form: { data: { turbo_confirm: "Are you sure you want to delete this meetup?" } } do %>
        <%= heroicon "trash", options: { class: "h-6 w-6" } %>
      <% end %>
      <%= link_to edit_meetup_path(id: meetup.id), class: "icon-btn btn--secondary", data: { turbo_frame: "modal" } do %>
        <%= heroicon "pencil-square", options: { class: "h-6 w-6" } %>
      <% end %>
    <% elsif !meetup.attendees.exists?(current_user.id) %>
      <div class="mt-auto">
        <%= render partial: "meetup_attendances/form", locals: { meetup_attendance: MeetupAttendance.new(meetup_id: meetup.id) } %>
      </div>
    <% end %>
  </aside>
</article>
