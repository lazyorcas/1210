<article class="card flex gap-x-4" id="<%= dom_id meetup %>">
  <div class="grow flex flex-col gap-y-2">
    <div>
      <p class="text-sm"><%= [meetup.organizer.name, meetup.attendees.map(&:name)].flatten.join(', ') %></p>
      <p class="text-sm">
        <%= meetup.local_start_time  %> - <%= meetup.local_end_time  %>
        <% if meetup.local_start_time != meetup.start_time %>
          (your time)
        <% end %>
      </p>
    </div>
    <h2 class="text-xl font-bold"><%= meetup.title %></h2>
    <% if meetup.description.present? %>
      <p><%= meetup.description %></p>
    <% end %>
    <% if meetup.organizer == current_user %>
      <hr/>
      <p class="text-sm text-neutral-500">Shared with
        <% if meetup.invitees.empty? %>
          no one.
        <% elsif meetup.invitees.count == meetup.organizer.friends.count %>
          all friends.
        <% else %>
          <%= meetup.invitees.map(&:name).sort.join(", ") %>.
        <% end %>
      </p>
    <% end %>
  </div>
  <% if meetup.organizer == current_user %>
    <aside class="shrink-0 flex flex-col gap-y-4 items-end justify-between">
      <%= button_to meetup_path(meetup), method: :delete, class: "icon-btn", form: { data: { turbo_confirm: "Are you sure you want to delete this meetup?" } } do %>
        <%= heroicon "trash", options: { class: "h-6 w-6" } %>
      <% end %>
      <%= link_to edit_meetup_path(meetup), class: "icon-btn btn--secondary", data: { turbo_frame: "modal" } do %>
        <%= heroicon "pencil-square", options: { class: "h-6 w-6" } %>
      <% end %>
    </aside>
  <% else %>
    <aside class="shrink-0 mt-auto">
      <%= render partial: "meetups/invitations/invitee_form", locals: { invitation: meetup.invitations.find_by(invitee: current_user) } %>
    </aside>
  <% end %>
</article>
