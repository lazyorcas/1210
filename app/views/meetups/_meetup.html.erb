<% current_user_is_attending = meetup.attendees.exists?(current_user.id) %>
<article class="flex flex-col gap-y-0.5" id="<%= dom_id(meetup) %>">
  <div class="card flex gap-x-4 justify-between">
    <%= link_to meetup_path(meetup), class: "grow flex flex-col gap-y-2", data: { turbo_frame: "modal" } do %>
      <div>
        <p class="text-sm"><%= ([meetup.organizer] +  meetup.attendees).map(&:name).join(', ') %></p>
        <p class="text-sm">
          <% if meetup.date >= Time.zone.today && meetup.date <= 1.week.from_now %>
            <%= meetup.date.strftime("%A") %>,
          <% else %>
            <%= meetup.date.strftime("%B #{meetup.date.day.ordinalize}") %>,
          <% end %>
          <%= meetup.local_start_time  %> - <%= meetup.local_end_time  %>
          <% if meetup.local_start_time != meetup.start_time %>
            (your time)
          <% end %>
        </p>
      </div>
      <h2 class="text-xl font-bold"><%= meetup.title %></h2>
      <% if meetup.description.present? %>
        <p class="text-sm"><%= meetup.description %></p>
      <% end %>
    <% end %>
    <% if meetup.organizer != current_user %>
      <% if current_user_is_attending %>
        <div class="self-start shrink-0 flex items-center gap-x-1">
          <span class="rounded-full bg-green-500 h-2 w-2"></span>
          <p class="text-sm">Going</p>
        </div>
      <% else %>
        <% invitation = current_user.meetup_invitations.find_by(inviter: meetup) %>
        <%= form_with model: invitation, url: meetups_invitation_path(invitation), class: "self-end" do |form| %>
          <%= form.hidden_field :is_accepted, value: true, required: true %>
          <%= form.button :submit, class: "w-full btn btn--primary" do %>
            I'm in
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <% if meetup.organizer == current_user %>
    <aside class="pl-4 text-sm text-neutral-500">Shared with
      <% if meetup.invitees.empty? %>
        no one.
      <% elsif meetup.invitees.length == meetup.organizer.friends.length %>
        all friends.
      <% else %>
        <%= meetup.invitees.length %> friends.
      <% end %>
    </aside>
  <% end %>
</article>
