<article class="flex flex-col gap-y-0.5" id="<%= dom_id(meetup) %>">
  <div class="card flex gap-x-4">
    <%= link_to meetup_path(meetup), class: "grow flex flex-col gap-y-2", data: { turbo_frame: "modal" } do %>
      <div>
        <p class="text-sm"><%= ([meetup.organizer] +  meetup.attendees).map(&:name).join(', ') %></p>
        <p class="text-sm">
          <%= meetup.start_time  %> - <%= meetup.end_time  %>
        </p>
      </div>
      <div>
        <h3 class="text-xl font-bold"><%= meetup.title %></h2>
        <% if meetup.description.present? %>
          <p class="text-sm"><%= meetup.description %></p>
        <% end %>
      </div>
    <% end %>
    <% if meetup.organizer != current_user %>
      <% if meetup.attendees.exists?(current_user.id) %>
        <div class="self-start shrink-0 flex items-center gap-x-1">
          <span class="rounded-full bg-green-500 h-2 w-2"></span>
          <p class="text-sm">Going</p>
        </div>
      <% else %>
        <% invitation = current_user.meetup_invitations.find_by(inviter: meetup) %>
        <%= form_with model: invitation, class: "self-end" do |form| %>
          <%= form.hidden_field :is_accepted, value: true, required: true %>
          <%= form.button :submit, class: "w-full btn btn--primary" do %>
            I'm in
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <% if meetup.organizer == current_user %>
    <aside class="px-4 flex self-end items-center gap-x-1 text-xs text-neutral-500">
      <p class="flex items-center gap-x-0.5">
        <%= heroicon "eye", options: { class: "h-3.5 w-3.5" } %>
        <%= meetup.seen_invitees.count %>
      </p>
      /
      <p class="flex items-center gap-x-0.5">
        <%= heroicon "envelope", options: { class: "h-3.5 w-3.5" } %>
        <%= meetup.invitees.count %>
      </p>
    </aside>
  <% end %>
</article>
