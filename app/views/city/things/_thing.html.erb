<article class="snap-always snap-center min-w-full flex flex-col gap-y-4">
  <div class="polaroid overflow-y-scroll grow">
    <div class="relative">
      <%= image_tag thing.image_url, class: "thumbnail rounded-t-xl w-full" %>
      <%= link_to thing.url, class: "absolute right-2 top-2 icon-btn btn--secondary", target: "_blank" do %>
        <% if thing.url.include?("maps.app.goo.gl") %>
          <%= heroicon "map" %>
        <% elsif thing.url.include?("youtube") %>
          <%= heroicon "video-camera" %>
        <% else %>
          <%= heroicon "arrow-top-right-on-square" %>
        <% end %>
      <% end %>
    </div>
    <div class="polaroid__content flex flex-col gap-y-4">
      <header>
        <h2 class="text-xl font-bold"><%= thing.title %></h2>
        <% if thing.description.present? %>
          <p class="text-sm"><%= thing.description %></p>
        <% end %>
      </header>
      <aside class="flex gap-1 flex-wrap">
        <% ([thing.type] + thing.tags.split('|')).each do |tag| %>
          <span class="chip chip--default">
            <%= tag %>
          </span>
        <% end %>
      </aside>
    </div>
  </div>
  <nav class="shrink-0 mt-auto flex justify-center gap-x-2">
    <%= link_to new_user_path, class: "icon-btn bg-red-400 text-red-800" do %>
      <%= heroicon "hand-thumb-down", variant: "solid", options: { class: "h-8 w-8" } %>
    <% end %>
    <%= link_to new_user_path, class: "icon-btn bg-green-400 text-green-800" do %>
      <%= heroicon "hand-thumb-up", variant: "solid", options: { class: "h-8 w-8" } %>
    <% end %>
  </nav>
</article>
