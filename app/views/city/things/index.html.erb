<% if browser.device.mobile? %>
  <div class="social-network__body flex flex-col h-full">
    <header class="shrink-0 w-full flex flex-col p-4">
      <%= link_to "1210", root_path, class: 'text-xl font-black' %>
      <h1 class="text-3xl font-black"><%= @city %></h1>
    </header>
    <main class="grow w-full flex snap-mandatory snap-x overflow-x-scroll gap-x-2 px-4 pb-4 standalone:pb-10">
      <%= render partial: "thing", collection: @things %>
      <div class="snap-always snap-center min-w-full flex flex-col gap-y-2 items-center justify-center">
        <%= link_to new_user_path, class: "btn btn--primary" do %>
          Sign up to see more
        <% end %>
        <p class="text-sm text-center px-4">Discover common interests with your friends. New things added weekly. </p>
      </div>
    </main>
  </div>
<% else %>
  <div class="h-full flex flex-col items-center justify-center bg-neutral-75">
    <div class="card flex flex-col gap-y-4">
      <header>
        <%= link_to "1210", root_path, class: 'text-xl font-black' %>
        <h1 class="text-3xl font-black">Things to do in <%= @city %></h1>
      </header>
      <p>You can only see the content of this page on your phone.</p>
      <%= link_to "What is 1210?", root_path, class: "btn btn--primary" %>
    </div>
  </div>
<% end %>