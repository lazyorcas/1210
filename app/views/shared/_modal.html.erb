<%= turbo_frame_tag "modal" do %>
  <div class="w-full h-[100dvh] fixed inset-x-0 bottom-0 z-50 flex flex-col items-center justify-end sm:justify-center" data-controller="modal">
    <div class="absolute bg-neutral-900/[0.8] w-full h-full" data-action="click->modal#close"></div>
    <dialog class="w-full sm:w-fit sm:max-w-[calc(100vw-32px)] max-h-[90%] sm:h-fit sm:max-h-[calc(100vh-32px)] bg-white standalone:pb-12 sm:pb-4 rounded-t-xl sm:rounded-xl px-4 py-4 flex flex-col gap-y-2" open>
      <header class="flex items-center justify-between shrink-0">
        <% if local_assigns[:title].present? %>
          <h1 class="text-xl font-bold"><%= title %></h1>
        <% end %>
        <nav class="shrink-0 ml-auto flex items-center gap-x-2">
          <% if local_assigns[:comments_path].present? %>
            <%= link_to comments_path, data: { turbo_frame: "modal" } do %>
              <%= heroicon "chat-bubble-left-right", options: { class: "h-6 w-6" } %>
            <% end %>
          <% end %>
          <%= button_tag type: "button", data: { action: "click->modal#close" }, class: 'icon-btn icon-btn--small' do %>
            <%= heroicon "x-mark", options: { class: "h-6 w-6" } %>
          <% end %>
        </nav>
      </header>
      <div class="flex-grow overflow-y-scroll">
        <%= yield %>
      </div>
    </dialog>
  </div>
<% end %>
