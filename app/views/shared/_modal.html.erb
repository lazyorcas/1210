<%= turbo_frame_tag "modal" do %>
  <div class="w-full h-[100dvh] fixed inset-x-0 bottom-0 z-50 flex flex-col items-center justify-end" data-controller="modal">
    <div class="absolute bg-neutral-900/[0.8] w-full h-full" <%= local_assigns[:close_disabled].nil? ? "data-action=click->modal#close" : nil %>></div>
    <dialog class="w-full max-h-[90%] overflow-y-scroll bg-white standalone:pb-12 rounded-t-xl px-4 py-4 flex flex-col" open>
      <header class="flex items-center justify-between">
        <% if local_assigns[:title].present? %>
          <h1 class="text-xl font-bold"><%= title %></h1>
        <% end %>
        <nav class="shrink-0 ml-auto flex items-center gap-x-2">
          <% if local_assigns[:comments_path].present? %>
            <%= link_to comments_path, data: { turbo_frame: "modal" } do %>
              <%= heroicon "chat-bubble-left-right", options: { class: "h-6 w-6" } %>
            <% end %>
          <% end %>
          <% if local_assigns[:close_disabled].nil? %>
            <%= button_tag type: "button", data: { action: "click->modal#close" }, class: 'icon-btn icon-btn--small' do %>
              <%= heroicon "x-mark", options: { class: "h-6 w-6" } %>
            <% end %>
          <% end %>
        </nav>
      </header>
      <%= yield %>
    </dialog>
  </div>
<% end %>
