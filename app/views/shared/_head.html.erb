<head>
  <title>1210 – Social Network, Done Differently</title>
  <meta name="description" content="1210 is a social network that focuses on bringing friends together more often to build memories and better relationships.">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="manifest" crossorigin="use-credentials" href="/manifest.json">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= preload_link_tag "Inter.ttf", as: "font", type: "font/ttf" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <% if current_user %>
    <%= render partial: "shared/push_subscription" %>
  <% end %>
</head>
