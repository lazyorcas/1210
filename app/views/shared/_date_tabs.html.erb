<nav class="shrink-0 border-b flex w-full gap-x-4">
  <%= render layout: "shared/date_tab", locals: { path: request.params.merge(date: Time.zone.today), active: @date == Time.zone.today } do %>
    Today
  <% end %>
  <%= render layout: "shared/date_tab", locals: { path: request.params.merge(date: Time.zone.tomorrow), active: @date == Time.zone.tomorrow } do %>
    Tomorrow
  <% end %>
  <% [2.day, 3.day, 4.day].map do |duration| %>
    <%= render layout: "shared/date_tab", locals: { path: request.params.merge(date: Time.zone.today + duration), active: @date == Time.zone.today + duration } do %>
      <%= (Time.zone.today + duration).strftime('%a') %>
    <% end %>
  <% end %>
</nav>
