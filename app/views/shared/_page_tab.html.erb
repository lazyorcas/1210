<% is_current_page = current_page?(path) %>
<%= link_to path, class: class_names("relative flex-1 flex flex-col items-center justify-center h-fit hover:text-neutral-900 transition-colors text-xs", { "text-neutral-400": !is_current_page }) do %>
  <%= heroicon icon_name, variant: is_current_page ? "solid" : "outline", options: { class: "h-6 w-6" } %>
  <%= yield %>
<% end %>
