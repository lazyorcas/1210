<%= link_to path, class: class_names("flex-1 flex flex-col items-center justify-center h-fit hover:text-neutral-900 transition-colors text-sm", { "text-neutral-400": !current_page?(path) }) do %>
  <%= heroicon icon_name, variant: current_page?(path) ? "solid" : "outline", options: { class: "h-6 w-6" } %>
  <%= yield %>
<% end %>
