<nav class="fixed bottom-0 w-full max-w-xl self-center border-t flex justify-around gap-x-2 min-h-[76px] pt-4 standalone:pb-12 px-6 bg-white">
  <%= render layout: "shared/page_tab", locals: { icon_name: "photo", path: memories_path } do %>
    Memories
  <% end %>
  <%= render layout: "shared/page_tab", locals: { icon_name: "heart", path: ideas_path } do %>
    Ideas
    <% if Thing.pending(current_user).count > 0 %>
      <div class="status status--empty absolute -mr-8 -mt-10"></div>
    <% end %>
  <% end %>
  <%= render layout: "shared/page_tab", locals: { icon_name: "bolt", path: meetups_path } do %>
    Meetups
  <% end %>
  <%= render layout: "shared/page_tab", locals: { icon_name: "user-group", path: current_user_friends_path } do %>
    Friends
    <% if current_user.received_invitations.pending.count > 0 %>
      <div class="status status--textful absolute -mr-8 -mt-10">
        <%= current_user.received_invitations.pending.count %>
      </div>
    <% elsif current_user.availabilities.count > 0 %>
      <div class="status status--empty absolute -mr-8 -mt-10"></div>
    <% end %>
  <% end %>
  <%= render layout: "shared/page_tab", locals: { icon_name: "user-circle", path: current_user_profile_path } do %>
    Profile
    <% if current_user.availabilities.count == 0 %>
      <div class="status status--empty absolute -mr-8 -mt-10"></div>
    <% end %>
  <% end %>
</nav>
