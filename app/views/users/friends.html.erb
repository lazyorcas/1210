<main class="grow w-full flex flex-col gap-y-4 py-4">
  <header class="flex-1 shrink-0 flex flex-col gap-y-2">
    <h1 class="text-xl font-bold">Friends</h1>
    <div class="flex gap-x-2">
      <%= link_to user_path(id: current_user.id), class: "btn btn--primary w-fit", data: { turbo_frame: "modal" } do %>
        Invite friends
      <% end %>
      <%= link_to user_path(id: current_user.id, add_friend: true), class: "btn btn--secondary w-fit", data: { turbo_frame: "modal" } do %>
        Add friend
      <% end %>
    </div>
    <p>
      <% if current_user.friends.empty? %>
        You have no friends on here yet.
      <% else %>
        Your friends are listed here. <br/>
        <%= current_user.friends.map(&:name).join(', ') %>
      <% end %>
    </p>
    <% %>
  </header>
  <section class="flex-1 shrink-0 flex flex-col gap-y-2">
    <h2 class="text-lg font-semibold border-b">Received Requests</h2>
    <ul class="flex flex-col gap-y-2">
      <% if current_user.received_invites.friend_requests.pending.empty? %>
        You don't have any pending request from others.
      <% else %>
        <% current_user.received_invites.friend_requests.pending.each do |friend_request| %>
          <li class="flex items-center hover:bg-neutral-100 transition rounded-xl justify-between pl-4">
            <%= friend_request.inviter.name %>
            <%= link_to accept_invite_path(id: friend_request.id), class: "icon-btn btn--primary" do %>
              <%= heroicon "hand-thumb-up", options: { class: "h-6 w-6" } %>
            <% end %>
          </li>
        <% end %>
      <% end %>
    </ul>
  </section>
  <section class="flex-1 shrink-0 flex flex-col gap-y-2">
    <h2 class="text-lg font-semibold border-b">Sent Requests</h2>
    <p>
      <% if current_user.sent_invites.friend_requests.pending.empty? %>
        You don't have any pending request to others.
      <% else %>
        <%= current_user.sent_invites.friend_requests.pending.map(&:invitee).map(&:name).join(', ') %>
      <% end %>
    </p>
  </section>
</main>
