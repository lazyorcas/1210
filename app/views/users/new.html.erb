<main class="my-auto w-full p-4 flex flex-col gap-y-16">
  <header class="w-full flex flex-col">
    <%= link_to root_path, class: "text-xl font-black flex items-center gap-x-2" do %>
      <%= heroicon "chevron-left", options: { class: "h-4 w-4" } %>
      1210
    <% end %>
    <h1 class="text-5xl font-black">Sign Up</h1>
    <%= render partial: "shared/flash/error" %>
  </header>
  <%= form_for User.new, html: { class: "w-full form-flow" } do |form| %>
    <div class="form-inputs-flow">
      <div class="input-container">
        <%= form.label :name, "Display name" %>
        <%= form.text_field :name, required: true, placeholder: "enter your name", class: "input" %>
      </div>
      <div class="input-container">
        <%= form.label :email %>
        <%= form.email_field :email, required: true, placeholder: "you@awesome.com", class: "input" %>
      </div>
      <div class="input-container">
        <datalist id="cities">
          <% City.all.each do |city| %>
            <option value="<%= city %>"></option>
          <% end %>
        </datalist>
        <%= form.label :city %>
        <%= form.text_field :city, list: "cities", class: "input", required: true, placeholder: "e.g. Munich", autocomplete: "off", maxlength: 30 %>
      </div>
      <div class="input-container">
        <%= form.label :time_zone %>
        <%= form.time_zone_select :time_zone, nil, { default: "Berlin", include_blank: true }, { class: "input select", required: true } %>
      </div>
    </div>
    <% if params[:user_invitation_public_hash_value].present? %>
      <%= form.hidden_field :user_invitation_public_hash_value, value: params[:user_invitation_public_hash_value] %>
    <% end %>
    <%= form.button "Create account", class: "btn btn--primary" %>
  <% end %>
  <div class="flex flex-col gap-y-1">
    <p>If you already have an account:</p>
    <%= link_to users_sign_in_path, class: 'btn btn--secondary' do %>
      Sign in instead
    <% end %>
  </div>
</main>
