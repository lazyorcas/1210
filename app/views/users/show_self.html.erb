<%= render layout: "shared/modal" do %>
  <header class="flex items-center justify-between gap-x-4">
    <h1 class="text-2xl font-bold">
      <% if params[:add_friend].present? %>
        Add friend
      <% else %>
        Invite your friends
      <% end %>
    </h1>
    <%= render partial: "shared/modal_close_button" %>
  </header>
  <div class="w-full max-w-[400px]">
    <div data-controller="clipboard">
      <input data-clipboard-target="source" type="text" value="<%= user_url(current_user) %>" readonly hidden>
      <button class="btn btn--primary flex items-center gap-x-2 w-full my-8" data-action="clipboard#copy">
        <%= heroicon "clipboard-document", options: { class: "h-6 w-6" } %>
        <span data-clipboard-target="buttonLabel">
          <% if params[:add_friend].present? %>
            Copy link for your friend
          <% else %>
            Copy invite link
          <% end %>
        </span>
      </button>
    </div>
    <p>
      <% if params[:add_friend].present? %>
        Your friends will be able to send you a friend request by clicking on the link.
      <% else %>
        The accounts created from this link will automatically be added to your friend list.
      <% end %>
    </p>
  </div>
<% end %>
