<ul class="<%= class_names("flex items-center flex-wrap gap-2", local_assigns[:show_name] ? "gap-x-2" : "gap-x-1") %>">
  <% users.map do |user| %>
    <li>
      <%= render partial: "users/avatar", locals: { user: user, size: "tiny", show_name: local_assigns[:show_name] } %>
    </li>
  <% end %>
</ul>
