<main class="w-full max-w-[320px] m-auto flex flex-col gap-y-16">
  <header class="w-full flex flex-col">
    <%= link_to root_path, class: "text-xl font-black flex items-center gap-x-2" do %>
      1210
    <% end %>
    <h1 class="text-5xl font-black"><%= @user.name %> <br/>
      invites you.</h1>
  </header>
  <div class="flex flex-col gap-y-4">
    <%= link_to new_user_path(inviter_id: @user.id), class: 'btn btn--primary flex items-center gap-x-2 w-full' do %>
      <%= heroicon "sparkles", options: { class: "h-6 w-6" } %>
      Accept
    <% end %>
    <p class="italic">You will be redirected to create an account.</p>
  </div>
</main>
