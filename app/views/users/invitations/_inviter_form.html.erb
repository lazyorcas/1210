<%= form_with model: invitation, url: users_invitations_path do |form| %>
  <%= form.hidden_field :invitee_id, required: true %>
  <%= form.button :submit, class: "btn btn--primary flex items-center gap-x-2 w-full" do %>
    <%= heroicon "user-plus", options: { class: "h-6 w-6" } %>
    Add friend
  <% end %>
<% end %>
