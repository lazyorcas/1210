<header class="flex items-center gap-x-4 py-4">
  <%= link_to root_path do %>
    <%= heroicon "chevron-left", options: { class: "h-6 w-6" } %>
  <% end %>
  <h1 class="text-4xl font-black">Friends</h1>
</header>
<main class="grow w-full flex flex-col gap-y-4 pb-[92px] standalone:pb-24">
  <p>
    <% if current_user.friends.empty? %>
      You have no friends on here yet.
    <% else %>
      <%= current_user.friends.map(&:name).join(', ') %>
    <% end %>
  </p>
  <section class="flex-1 shrink-0 flex flex-col gap-y-2">
    <h2 class="text-lg font-semibold border-b">Received Requests</h2>
    <ul class="flex flex-col gap-y-2">
      <% if current_user.received_invitations.pending.empty? %>
        You don't have any pending request from others.
      <% else %>
        <% current_user.received_invitations.pending.each do |invitation| %>
          <li class="flex items-center hover:bg-neutral-100 transition rounded-xl justify-between pl-4">
            <%= invitation.inviter.name %>
            <%= form_with model: invitation, url: users_invitation_path(invitation) do |form| %>
              <%= form.hidden_field :is_accepted, value: true, required: true %>
              <%= form.button :submit, class: "btn btn--primary" do %>
                Accept
              <% end %>
            <% end %>
          </li>
        <% end %>
      <% end %>
    </ul>
  </section>
  <section class="flex-1 shrink-0 flex flex-col gap-y-2">
    <h2 class="text-lg font-semibold border-b">Sent Requests</h2>
    <p>
      <% if current_user.sent_invitations.pending.empty? %>
        You don't have any pending request to others.
      <% else %>
        <%= current_user.sent_invitations.pending.map(&:invitee).map(&:name).join(', ') %>
      <% end %>
    </p>
  </section>
</main>
<nav class="bottom-nav gap-x-4">
  <%= link_to user_path(current_user, add_friend: true), class: "btn btn--secondary flex-1", data: { turbo_frame: "modal" } do %>
    Add friend
  <% end %>
  <%= link_to user_path(current_user), class: "btn btn--primary flex-1", data: { turbo_frame: "modal" } do %>
    Invite friends
  <% end %>
</nav>
<%= turbo_frame_tag "modal" %>
