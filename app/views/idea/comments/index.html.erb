<%= render layout: "shared/modal", locals: { title: "Discussion" } do %>
  <div class="flex flex-col gap-y-8">
    <%= turbo_frame_tag "#{dom_id(@idea)}_comments", class: "sm:w-[400px] flex flex-col gap-y-2" do %>
      <%= render partial: "comments/comment", collection: @idea_comments %>
    <% end %>
    <%= render partial: "comments/form", locals: { comment: Idea::Comment.new } %>
  </div>
<% end %>
